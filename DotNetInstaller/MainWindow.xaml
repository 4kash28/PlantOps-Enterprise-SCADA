<Window x:Class="DotNetInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PlantOps™ Enterprise SCADA v2.4 LTS — Setup Wizard"
        Height="560" Width="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#f8fafc"
        Foreground="#0f172a"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background" Value="#2563eb"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1d4ed8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#cbd5e1"/>
                    <Setter Property="Foreground" Value="#94a3b8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryNavBtn" TargetType="Button">
            <Setter Property="Background" Value="#e2e8f0"/>
            <Setter Property="Foreground" Value="#0f172a"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#cbd5e1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Body (Sidebar + Content) -->
            <RowDefinition Height="*"/>
            <!-- 2: Footer / Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- ROW 0: TOP BRAND STRIP (Light White)                           -->
        <!-- ============================================================== -->
        <Border Grid.Row="0" Background="#ffffff" BorderBrush="#e2e8f0" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="36" Height="36" Background="#2563eb" CornerRadius="2" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M2,22V10L10,14V8L18,12V2H22V22H2M6,14H8V16H6V14M6,18H8V20H6V18M10,18H12V20H10V18M14,18H16V20H14V18M18,14H20V16H18V14M18,18H20V20H18V18M18,6H20V8H18V6M18,10H20V12H18V10Z" Fill="White"/>
                    </Viewbox>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="PlantOps™ Enterprise SCADA" FontWeight="Black" FontSize="14" Foreground="#0f172a" FontFamily="Consolas"/>
                        <Border Background="#dbeafe" BorderBrush="#bfdbfe" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                            <TextBlock Text="v2.4 LTS" FontSize="9" FontWeight="Bold" Foreground="#1d4ed8" FontFamily="Consolas"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Industrial Workstation Monitor • 100% Microsoft .NET (C#) Standalone Setup" 
                               FontSize="11" Foreground="#64748b" Margin="0,2,0,0"/>
                </StackPanel>

                <Border Grid.Column="2" Background="#ecfdf5" BorderBrush="#86efac" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                    <TextBlock Text="21 CFR PART 11 READY" FontSize="9" FontWeight="Black" Foreground="#047857" FontFamily="Consolas"/>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- ROW 1: SIDEBAR + STEP CONTAINER                                -->
        <!-- ============================================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Sidebar -->
                <ColumnDefinition Width="200"/>
                <!-- Content Area -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="#ffffff" BorderBrush="#e2e8f0" BorderThickness="0,0,1,0" Padding="14,18">
                <StackPanel>
                    <TextBlock Text="SETUP PROGRESS" FontSize="9" FontWeight="Bold" Foreground="#94a3b8" FontFamily="Consolas" Margin="0,0,0,14"/>

                    <Border x:Name="StepItem0" Background="#dbeafe" BorderBrush="#bfdbfe" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                        <TextBlock x:Name="StepTxt0" Text="1. Welcome" FontSize="11" FontWeight="Bold" Foreground="#1d4ed8"/>
                    </Border>
                    <Border x:Name="StepItem1" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                        <TextBlock x:Name="StepTxt1" Text="2. License (EULA)" FontSize="11" FontWeight="SemiBold" Foreground="#64748b"/>
                    </Border>
                    <Border x:Name="StepItem2" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                        <TextBlock x:Name="StepTxt2" Text="3. License &amp; Plant" FontSize="11" FontWeight="SemiBold" Foreground="#64748b"/>
                    </Border>
                    <Border x:Name="StepItem3" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                        <TextBlock x:Name="StepTxt3" Text="4. Directory &amp; Options" FontSize="11" FontWeight="SemiBold" Foreground="#64748b"/>
                    </Border>
                    <Border x:Name="StepItem4" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                        <TextBlock x:Name="StepTxt4" Text="5. Installation" FontSize="11" FontWeight="SemiBold" Foreground="#64748b"/>
                    </Border>
                    <Border x:Name="StepItem5" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                        <TextBlock x:Name="StepTxt5" Text="6. Complete" FontSize="11" FontWeight="SemiBold" Foreground="#64748b"/>
                    </Border>

                    <Border Background="#f1f5f9" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,24,0,0">
                        <StackPanel>
                            <TextBlock Text="ENGINE PLATFORM" FontSize="9" FontWeight="Bold" Foreground="#64748b" FontFamily="Consolas"/>
                            <TextBlock Text="Microsoft .NET 8 (C#)&#x0a;WPF Desktop Engine&#x0a;Local SQLite WAL" FontSize="10" Foreground="#334155" Margin="0,4,0,0" LineHeight="14"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Column="1" Margin="24,18">
                <!-- STEP 0: WELCOME -->
                <Grid x:Name="StepPanel0" Visibility="Visible">
                    <StackPanel>
                        <TextBlock Text="Welcome to PlantOps™ SCADA Setup" FontSize="17" FontWeight="Bold" Foreground="#0f172a" Margin="0,0,0,6"/>
                        <TextBlock Text="This setup wizard will install PlantOps™ Enterprise SCADA Host Engine on this workstation." 
                                   FontSize="12" Foreground="#475569" Margin="0,0,0,16" TextWrapping="Wrap"/>

                        <Border Background="#ffffff" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="KEY ENTERPRISE CAPABILITIES:" FontSize="10" FontWeight="Bold" Foreground="#64748b" FontFamily="Consolas" Margin="0,0,0,8"/>
                                <TextBlock Text="• 100% Native Microsoft .NET 8 (C#) Desktop Architecture" FontSize="11" Foreground="#334155" Margin="0,0,0,4"/>
                                <TextBlock Text="• Dedicated 21 CFR Part 11 Certified Audit Trail &amp; Stoppage Tracking" FontSize="11" Foreground="#334155" Margin="0,0,0,4"/>
                                <TextBlock Text="• Dynamic Factory &amp; Production Line Hierarchy Customization" FontSize="11" Foreground="#334155" Margin="0,0,0,4"/>
                                <TextBlock Text="• Unique 12-Digit One-Time Volume License Key Generated on Installation" FontSize="11" Foreground="#334155" Margin="0,0,0,4"/>
                                <TextBlock Text="• Registered in Windows Programs &amp; Features for Clean Control Panel Uninstall" FontSize="11" Foreground="#334155" Margin="0,0,0,4"/>
                                <TextBlock Text="• Zero Cloud Dependency — 100% Local Air-Gapped Factory Operation" FontSize="11" Foreground="#334155"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Click 'Next' to read and accept the official Software License Agreement (EULA)." FontSize="11" Foreground="#64748b"/>
                    </StackPanel>
                </Grid>

                <!-- STEP 1: LICENSE AGREEMENT (EULA) -->
                <Grid x:Name="StepPanel1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Software License Agreement (EULA)" FontSize="15" FontWeight="Bold" Foreground="#0f172a"/>
                        <TextBlock Text="Please read and accept the terms of the Enterprise Software License to continue:" FontSize="11" Foreground="#64748b" Margin="0,2,0,0"/>
                    </StackPanel>
                    
                    <Border Grid.Row="1" Background="#ffffff" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,0,12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="TxtLicenseTerms" IsReadOnly="True" Background="#f8fafc" Foreground="#1e293b" 
                                     BorderThickness="0" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap"
                                     Padding="8" VerticalScrollBarVisibility="Disabled"/>
                        </ScrollViewer>
                    </Border>

                    <StackPanel Grid.Row="2">
                        <RadioButton x:Name="RbAcceptLicense" Content="I accept the terms in the License Agreement (Authorized Deployment)" 
                                     Foreground="#0f172a" FontWeight="Bold" FontSize="11" Margin="0,0,0,5"
                                     Checked="OnLicenseAgreementChanged" Unchecked="OnLicenseAgreementChanged"/>
                        <RadioButton x:Name="RbDeclineLicense" Content="I do not accept the terms of the License Agreement" 
                                     IsChecked="True" Foreground="#64748b" FontSize="11"
                                     Checked="OnLicenseAgreementChanged" Unchecked="OnLicenseAgreementChanged"/>
                    </StackPanel>
                </Grid>

                <!-- STEP 2: LICENSE KEY ACTIVATION & PLANT PROFILE -->
                <Grid x:Name="StepPanel2" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Volume License &amp; Plant Profile Setup" FontSize="15" FontWeight="Bold" Foreground="#0f172a" Margin="0,0,0,4"/>
                        <TextBlock Text="Configure factory identity and verify the 12-digit one-time volume license key:" FontSize="11" Foreground="#64748b" Margin="0,0,0,12"/>

                        <Border Background="#ffffff" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                            <StackPanel>
                                <!-- Facility & Line Setup -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="1. PLANT / FACILITY NAME:" FontSize="9" FontWeight="Bold" Foreground="#64748b" FontFamily="Consolas"/>
                                        <TextBox x:Name="TxtWizardPlantName" Text="Plant 01 (Chennai Works)" 
                                                 Background="#f8fafc" Foreground="#0f172a" BorderBrush="#cbd5e1" BorderThickness="1"
                                                 Padding="8,4" FontWeight="Bold" FontSize="11" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="2. PRODUCTION LINE / UNIT:" FontSize="9" FontWeight="Bold" Foreground="#64748b" FontFamily="Consolas"/>
                                        <TextBox x:Name="TxtWizardLineName" Text="RAC Line 01" 
                                                 Background="#f8fafc" Foreground="#0f172a" BorderBrush="#cbd5e1" BorderThickness="1"
                                                 Padding="8,4" FontWeight="Bold" FontSize="11" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="3. DEPARTMENT / DIVISION:" FontSize="9" FontWeight="Bold" Foreground="#64748b" FontFamily="Consolas"/>
                                <TextBox x:Name="TxtWizardDivisionName" Text="Assembly Division" 
                                         Background="#f8fafc" Foreground="#0f172a" BorderBrush="#cbd5e1" BorderThickness="1"
                                         Padding="8,4" FontWeight="Bold" FontSize="11" Margin="0,3,0,10"/>

                                <TextBlock Text="12-DIGIT ONE-TIME VOLUME LICENSE KEY:" FontSize="9" FontWeight="Bold" Foreground="#64748b" FontFamily="Consolas"/>
                                <Grid Margin="0,3,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtLicenseKey" Text="8492-3158-7624" 
                                             Background="#f8fafc" Foreground="#15803d" BorderBrush="#cbd5e1" BorderThickness="1"
                                             Padding="10,6" FontWeight="Black" FontFamily="Consolas" FontSize="13" VerticalAlignment="Center"
                                             TextChanged="OnLicenseKey_TextChanged"/>
                                    <Button Grid.Column="1" Content="Generate New" Style="{StaticResource SecondaryNavBtn}" 
                                             Margin="8,0,0,0" Padding="12,6" FontSize="11" Click="OnGenerateNewKey_Click"
                                             ToolTip="Generate another fresh 12-digit one-time license key"/>
                                </Grid>

                                <!-- Live Status Badge -->
                                <Border x:Name="BadgeStatusBorder" Background="#ecfdf5" BorderBrush="#86efac" BorderThickness="1" CornerRadius="2" Padding="10,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Rectangle Width="6" Height="6" Fill="#15803d" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtStatusLabel" Text="STATUS: " FontSize="10" FontWeight="Bold" Foreground="#047857" FontFamily="Consolas"/>
                                        <TextBlock x:Name="TxtStatusValue" Text="12-DIGIT ONE-TIME KEY VERIFIED &amp; READY TO BIND" FontSize="10" FontWeight="Bold" Foreground="#15803d" FontFamily="Consolas"/>
                                    </StackPanel>
                                </Border>

                                <!-- Red Error Banner for invalid key -->
                                <TextBlock x:Name="TxtKeyError" Text="[FAILED] LICENSE FAILED: Key must be exactly 12 digits." 
                                           Visibility="Collapsed" Foreground="#b91c1c" FontWeight="Bold" FontSize="11" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#f1f5f9" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="2" Padding="10,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Notice: " FontSize="10" Foreground="#475569" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text="On installation, this 12-digit key will be saved as 'LICENSE_KEY.txt' in the software folder." 
                                           FontSize="10" Foreground="#475569" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- STEP 3: DIRECTORY & SETUP OPTIONS -->
                <Grid x:Name="StepPanel3" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Installation Directory &amp; Configuration" FontSize="15" FontWeight="Bold" Foreground="#0f172a" Margin="0,0,0,4"/>
                        <TextBlock Text="Select the target directory and optional components to apply during installation:" FontSize="11" Foreground="#64748b" Margin="0,0,0,12"/>

                        <!-- Destination Folder Picker -->
                        <Border Background="#ffffff" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="INSTALLATION FOLDER:" FontSize="9" FontWeight="Bold" Foreground="#64748b" FontFamily="Consolas"/>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtInstallPath" Text="C:\PlantOps_SCADA" 
                                             Background="#f8fafc" Foreground="#0f172a" BorderBrush="#cbd5e1" BorderThickness="1"
                                             Padding="8,5" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Browse..." Style="{StaticResource SecondaryNavBtn}" 
                                            Margin="8,0,0,0" Padding="12,5" FontSize="11" Click="OnBrowseFolder_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- System Configuration Checkboxes -->
                        <Border Background="#ffffff" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <TextBlock Text="SYSTEM REGISTRATION &amp; INTEGRATION:" FontSize="9" FontWeight="Bold" Foreground="#64748b" FontFamily="Consolas" Margin="0,0,0,8"/>

                                <CheckBox x:Name="ChkRegisterUninstall" Content="Register in Windows Programs &amp; Features (Control Panel Uninstaller)" 
                                          IsChecked="True" Foreground="#0f172a" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <CheckBox x:Name="ChkFirewall" Content="Configure Windows Defender Firewall (Allow Port 8090 TCP Inbound)" 
                                          IsChecked="True" Foreground="#0f172a" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <CheckBox x:Name="ChkDesktopShortcut" Content="Create Desktop Shortcut ('PlantOps Enterprise SCADA')" 
                                          IsChecked="True" Foreground="#0f172a" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <CheckBox x:Name="ChkStartMenuShortcut" Content="Create Windows Start Menu Program Shortcut" 
                                          IsChecked="True" Foreground="#0f172a" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- STEP 4: EXTRACTION & INSTALLATION PROGRESS -->
                <Grid x:Name="StepPanel4" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Installing PlantOps™ Enterprise SCADA..." FontSize="16" FontWeight="Bold" Foreground="#0f172a" Margin="0,0,0,6"/>
                        <TextBlock x:Name="TxtInstallStatus" Text="Extracting embedded Microsoft .NET 8 runtime and standalone engine..." FontSize="11" FontWeight="Bold" Foreground="#0284c7" Margin="0,0,0,14"/>

                        <ProgressBar x:Name="PbInstallProgress" Height="14" Minimum="0" Maximum="100" Value="15" 
                                     Foreground="#10b981" Background="#e2e8f0" BorderThickness="0" Margin="0,0,0,10"/>

                        <TextBlock x:Name="TxtInstallDetail" Text="Unpacking certified binaries into installation directory..." 
                                   FontSize="10" Foreground="#64748b" FontFamily="Consolas"/>
                    </StackPanel>
                </Grid>

                <!-- STEP 5: INSTALLATION COMPLETE -->
                <Grid x:Name="StepPanel5" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                            <Viewbox Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z" Fill="#15803d"/>
                            </Viewbox>
                            <TextBlock Text="Installation Completed Successfully!" FontSize="16" FontWeight="Bold" Foreground="#15803d" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="PlantOps™ Enterprise SCADA v2.4 LTS is now fully installed and configured." 
                                   FontSize="11" Foreground="#475569" Margin="0,0,0,12"/>

                        <!-- Installation Summary Card -->
                        <Border Background="#ffffff" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="INSTALLED RUNTIME SUMMARY:" FontSize="9" FontWeight="Bold" Foreground="#64748b" FontFamily="Consolas" Margin="0,0,0,8"/>
                                <TextBlock x:Name="TxtSummaryDetails" 
                                           Text="• Architecture: 100% Microsoft .NET 8 (C#) Standalone&#x0a;• 12-Digit License: ACTIVE&#x0a;• Compliance: 21 CFR Part 11 Certified&#x0a;• Database: app_local.db (SQLite WAL Mode Active)&#x0a;• Telemetry Ingestion: Port 8090 TCP Open&#x0a;• Registered in Windows Programs &amp; Features"
                                           FontSize="10" Foreground="#334155" FontFamily="Consolas" LineHeight="16"/>
                            </StackPanel>
                        </Border>

                        <CheckBox x:Name="ChkLaunchNow" Content="Launch PlantOps™ Enterprise SCADA now" 
                                  IsChecked="True" Foreground="#0f172a" FontWeight="Bold" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- ============================================================== -->
        <!-- ROW 2: BOTTOM NAV BUTTONS STRIP                                -->
        <!-- ============================================================== -->
        <Border Grid.Row="2" Background="#ffffff" BorderBrush="#e2e8f0" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource SecondaryNavBtn}" HorizontalAlignment="Left" Click="OnCancel_Click"/>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnBack" Content="&lt; Back" Style="{StaticResource SecondaryNavBtn}" Margin="0,0,8,0" Click="OnBack_Click"/>
                    <Button x:Name="BtnNext" Content="Next &gt;" Style="{StaticResource NavBtn}" Click="OnNext_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
