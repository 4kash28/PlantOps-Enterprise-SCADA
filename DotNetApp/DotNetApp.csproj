<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>plantops_monitor.ico</ApplicationIcon>
    <AssemblyName>PlantOpsEnterpriseSCADA</AssemblyName>
    <Product>PlantOps™ Enterprise SCADA</Product>
    <Version>2.4.0</Version>
    <AssemblyVersion>2.4.0.0</AssemblyVersion>
    <FileVersion>2.4.0.0</FileVersion>
    <Authors>PlantOps Industrial Automation Solutions</Authors>
    <Company>PlantOps Industrial Automation Solutions</Company>
    <Description>PlantOps™ Enterprise SCADA Central Monitoring &amp; Telemetry Server (21 CFR Part 11 Compliant)</Description>
    <Copyright>Copyright © 2026 PlantOps Industrial Automation Solutions. All rights reserved.</Copyright>
    <AssemblyTitle>PlantOps™ Enterprise SCADA Server</AssemblyTitle>
    <NeutralLanguage>en-US</NeutralLanguage>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <None Update="plantops_monitor.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Resource Include="plantops_monitor.png" />
  </ItemGroup>

</Project>
