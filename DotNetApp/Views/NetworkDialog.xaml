<Window x:Class="DotNetApp.Views.NetworkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SCADA Network &amp; Line Node Ingestion Configuration"
        Height="580" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#f8fafc"
        Foreground="#0f172a"
        FontFamily="Segoe UI">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Form Body -->
            <RowDefinition Height="*"/>
            <!-- 2: Action Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header (2D Flat) -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="34" Height="34" Background="#dbeafe" BorderBrush="#bfdbfe" BorderThickness="1" CornerRadius="2" Margin="0,0,12,0">
                    <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 12,2M11,19.93C7.05,19.44 4,16.08 4,12C4,11.38 4.08,10.79 4.21,10.21L9,15V16C9,17.1 9.9,18 11,18V19.93M17.9,17.39C17.64,16.58 16.9,16 16,16H15V13C15,12.45 14.55,12 14,12H8V10H10C10.55,10 11,9.55 11,9V7H13C14.1,7 15,6.1 15,5V4.59C17.93,5.78 20,8.65 20,12C20,14.08 19.2,15.97 17.9,17.39Z" Fill="#0284c7"/>
                    </Viewbox>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SCADA NETWORK PROFILE WIZARD" FontWeight="Black" FontSize="14" Foreground="#0f172a" FontFamily="Consolas"/>
                    <TextBlock Text="Bind host IP and TCP port for remote LineNode Agent telemetry stream ingestion" 
                               FontSize="11" Foreground="#64748b" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Form Fields Card (2D Flat) -->
        <Border Grid.Row="1" Background="#ffffff" CornerRadius="2" Padding="18,16" BorderBrush="#e2e8f0" BorderThickness="1">
            <StackPanel>
                <!-- Active Host IP -->
                <TextBlock Text="SERVER BIND HOST IP (IPV4):" FontSize="9" FontWeight="Bold" Foreground="#475569" FontFamily="Consolas"/>
                <TextBox x:Name="TxtHostIp" Height="30" Margin="0,4,0,10" Background="#f8fafc" Foreground="#0284c7" FontWeight="Bold" 
                         BorderBrush="#cbd5e1" BorderThickness="1" Padding="8,4" FontSize="12" FontFamily="Consolas" VerticalContentAlignment="Center"/>

                <!-- TCP Ingestion Port -->
                <TextBlock Text="TCP INGESTION &amp; WEBSOCKET PORT:" FontSize="9" FontWeight="Bold" Foreground="#475569" FontFamily="Consolas"/>
                <TextBox x:Name="TxtPort" Height="30" Margin="0,4,0,10" Background="#f8fafc" Foreground="#0f172a" FontWeight="Bold" 
                         BorderBrush="#cbd5e1" BorderThickness="1" Padding="8,4" FontSize="12" FontFamily="Consolas" VerticalContentAlignment="Center"/>

                <!-- Subnet CIDR -->
                <TextBlock Text="SUBNET ENFORCEMENT CIDR:" FontSize="9" FontWeight="Bold" Foreground="#475569" FontFamily="Consolas"/>
                <TextBox x:Name="TxtSubnet" Height="30" Margin="0,4,0,10" Background="#f8fafc" Foreground="#0f172a" 
                         BorderBrush="#cbd5e1" BorderThickness="1" Padding="8,4" FontSize="12" FontFamily="Consolas" VerticalContentAlignment="Center"/>

                <!-- Gateway -->
                <TextBlock Text="DEFAULT INDUSTRIAL GATEWAY:" FontSize="9" FontWeight="Bold" Foreground="#475569" FontFamily="Consolas"/>
                <TextBox x:Name="TxtGateway" Height="30" Margin="0,4,0,14" Background="#f8fafc" Foreground="#0f172a" 
                         BorderBrush="#cbd5e1" BorderThickness="1" Padding="8,4" FontSize="12" FontFamily="Consolas" VerticalContentAlignment="Center"/>

                <!-- Ingestion URL Preview Box (Full Visibility, No Cutoff, 2D Flat) -->
                <Border Background="#f0fdf4" BorderBrush="#86efac" BorderThickness="1" CornerRadius="2" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="LINE NODE AGENT TARGET URL:" FontSize="9" FontWeight="Black" Foreground="#15803d" FontFamily="Consolas"/>
                            <TextBlock x:Name="TxtUrlPreview" Text="http://192.168.19.170:5050/api/telemetry" 
                                       FontSize="12" FontFamily="Consolas" FontWeight="Bold" Foreground="#166534" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Width="95" Height="28" 
                                Background="#dcfce7" Foreground="#15803d" BorderBrush="#86efac" BorderThickness="1" 
                                FontWeight="Bold" FontSize="10" Cursor="Hand" Click="CopyUrl_Click" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="10" Height="10" Margin="0,0,4,0" VerticalAlignment="Center">
                                    <Path Data="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z" Fill="#15803d"/>
                                </Viewbox>
                                <TextBlock Text="Copy URL"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Action Buttons (2D Flat) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Close" Width="95" Height="34" Margin="0,0,10,0" Background="#f1f5f9" Foreground="#334155" BorderBrush="#cbd5e1" BorderThickness="1" FontWeight="SemiBold" Cursor="Hand" Click="Close_Click"/>
            <Button Width="165" Height="34" Background="#2563eb" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="Save_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center">
                        <Path Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z" Fill="White"/>
                    </Viewbox>
                    <TextBlock Text="Save &amp; Apply Profile"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
