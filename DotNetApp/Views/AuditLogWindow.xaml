<Window x:Class="DotNetApp.Views.AuditLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System Parameter &amp; Threshold Breach Audit Trail — PlantOps™ SCADA"
        Height="750" Width="1280"
        MinWidth="960" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{Binding CanvasBg}"
        Foreground="{Binding TextMain}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <!-- Tab Button Style -->
        <Style x:Key="TabFilterBtn" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="14,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{Binding TextMuted, RelativeSource={RelativeSource AncestorType=Window}}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Header Strip -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Filters & Search Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- 2: DataGrid Content -->
            <RowDefinition Height="*"/>
            <!-- 3: Status Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- ROW 0: TOP CORPORATE HEADER STRIP                               -->
        <!-- ============================================================== -->
        <Border Grid.Row="0" Background="{Binding HeaderBg}" BorderBrush="{Binding HeaderBorder}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title & Subtitle -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Modern Activity Icon -->
                        <Border Width="32" Height="32" CornerRadius="6" Background="#eff6ff" BorderBrush="#bfdbfe" BorderThickness="1" Margin="0,0,10,0">
                            <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M19,3H14.82C14.4,1.84 13.3,1 12,1C10.7,1 9.6,1.84 9.18,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M12,3A1,1 0 0,1 13,4A1,1 0 0,1 12,5A1,1 0 0,1 11,4A1,1 0 0,1 12,3M7,7H17V9H7V7M7,11H17V13H7V11M7,15H14V17H7V15Z" Fill="#2563eb"/>
                            </Viewbox>
                        </Border>
                        
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SYSTEM PARAMETER &amp; THRESHOLD BREACH AUDIT TRAIL" FontWeight="Bold" FontSize="14" Foreground="{Binding HeaderFg}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Action Buttons (2D Flat) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Refresh Button -->
                    <Button Click="OnRefresh_Click" Height="30" Padding="12,4" Margin="0,0,10,0"
                            Background="{Binding HeaderBtnBg}" Foreground="{Binding HeaderBtnFg}" BorderBrush="{Binding HeaderBtnBorder}" BorderThickness="1"
                            FontWeight="SemiBold" FontSize="11" Cursor="Hand" ToolTip="Reload threshold breach records from SQLite database">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="11" Height="11" Margin="0,0,5,0" VerticalAlignment="Center">
                                <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z" Fill="{Binding HeaderBtnFg}"/>
                            </Viewbox>
                            <TextBlock Text="Refresh Logs"/>
                        </StackPanel>
                    </Button>

                    <!-- Clear / Reset Audit Log -->
                    <Button Command="{Binding ClearAuditLogsCommand}" Height="30" Padding="12,4" Margin="0,0,10,0"
                            Background="#fee2e2" Foreground="#dc2626" BorderBrush="#fca5a5" BorderThickness="1"
                            FontWeight="Bold" FontSize="11" Cursor="Hand" ToolTip="Purge all threshold breach audit logs and reset counter to zero">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="11" Height="11" Margin="0,0,5,0" VerticalAlignment="Center">
                                <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z" Fill="#dc2626"/>
                            </Viewbox>
                            <TextBlock Text="Clear Logs (Reset to 0)"/>
                        </StackPanel>
                    </Button>

                    <!-- Export Excel Report -->
                    <Button Command="{Binding ExportExcelCommand}" Height="30" Padding="12,4" Margin="0,0,8,0"
                            Background="#15803d" Foreground="White" BorderThickness="0"
                            FontWeight="Bold" FontSize="11" Cursor="Hand" ToolTip="Export styled, auto-formatted threshold breach report to Microsoft Excel (.xls)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Path Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M15.8,18H14L12,14.6L10,18H8.2L11.1,13.5L8.3,9H10.1L12,12.4L13.9,9H15.7L12.9,13.5L15.8,18Z" Fill="White"/>
                            </Viewbox>
                            <TextBlock Text="Export Excel (.xls)"/>
                        </StackPanel>
                    </Button>

                    <!-- Export Official PDF -->
                    <Button Command="{Binding ExportPdfCommand}" Height="30" Padding="12,4"
                            Background="#b91c1c" Foreground="White" BorderThickness="0"
                            FontWeight="Bold" FontSize="11" Cursor="Hand" ToolTip="Export publication-ready 21 CFR Part 11 PDF audit report">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Path Data="M19,3H5C3.9,3 3,3.9 3,5V19C3,20.1 3.9,21 5,21H19C20.1,21 21,20.1 21,19V5C21,3.9 20.1,3 19,3M9.5,11.5C9.5,12.3 8.8,13 8,13H7V15H5.5V9H8C8.8,9 9.5,9.7 9.5,10.5V11.5M14.5,13.5C14.5,14.3 13.8,15 13,15H10.5V9H13C13.8,9 14.5,9.7 14.5,10.5V13.5M18.5,10.5H16V12H18V13.5H16V15H14.5V9H18.5V10.5M7,10.5V11.5H8V10.5H7M12,10.5V13.5H13V10.5H12Z" Fill="White"/>
                            </Viewbox>
                            <TextBlock Text="Export PDF (.pdf)"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- ROW 1: FILTERS & SEARCH TOOLBAR (2D FLAT)                      -->
        <!-- ============================================================== -->
        <Border Grid.Row="1" Background="{Binding SubHeaderBg}" BorderBrush="{Binding SubHeaderBorder}" BorderThickness="0,0,0,1" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Filter Buttons Strip -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{Binding CanvasBg}" CornerRadius="2" Padding="3" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="📊 System Violation Counts" Command="{Binding SetFilterCommand}" CommandParameter="SUMMARY"
                                    Height="26" Padding="12,2" FontWeight="Bold" FontSize="11" Cursor="Hand"
                                    Background="{Binding IsFilterSummary, Converter={StaticResource BoolToVis}}" 
                                    Foreground="{Binding TextMain}" BorderThickness="0" Margin="0,0,2,0"/>
                            <Button Content="All Breach Events" Command="{Binding SetFilterCommand}" CommandParameter="ALL"
                                    Height="26" Padding="12,2" FontWeight="Bold" FontSize="11" Cursor="Hand"
                                    Background="{Binding IsFilterAll, Converter={StaticResource BoolToVis}}" 
                                    Foreground="{Binding TextMain}" BorderThickness="0" Margin="0,0,2,0"/>
                            <Button Content="Active Violations" Command="{Binding SetFilterCommand}" CommandParameter="ACTIVE"
                                    Height="26" Padding="12,2" FontWeight="Bold" FontSize="11" Cursor="Hand"
                                    Background="{Binding IsFilterActive, Converter={StaticResource BoolToVis}}" 
                                    Foreground="{Binding TextMain}" BorderThickness="0" Margin="0,0,2,0"/>
                            <Button Content="Normalized / Cleared" Command="{Binding SetFilterCommand}" CommandParameter="RESOLVED"
                                    Height="26" Padding="12,2" FontWeight="Bold" FontSize="11" Cursor="Hand"
                                    Background="{Binding IsFilterResolved, Converter={StaticResource BoolToVis}}" 
                                    Foreground="{Binding TextMain}" BorderThickness="0"/>
                        </StackPanel>
                    </Border>

                    <!-- Summary Badge Counters -->
                    <Border Background="#0284c7" CornerRadius="2" Padding="8,4" Margin="14,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AuditLogCount, StringFormat='Total Violations: {0}'}" FontSize="10" FontWeight="Bold" Foreground="White" FontFamily="Consolas"/>
                    </Border>
                    <Border Background="#dc2626" CornerRadius="2" Padding="8,4" Margin="0,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveStoppagesLogCount, StringFormat='Active: {0}'}" FontSize="10" FontWeight="Bold" Foreground="White" FontFamily="Consolas"/>
                    </Border>
                    <Border Background="#16a34a" CornerRadius="2" Padding="8,4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding BreachedStationsCount, StringFormat='Systems Breached: {0}'}" FontSize="10" FontWeight="Bold" Foreground="White" FontFamily="Consolas"/>
                    </Border>
                </StackPanel>

                <!-- Right: Search Box (2D Flat) -->
                <Border Grid.Column="2" Background="{Binding CanvasBg}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="8,2" VerticalAlignment="Center" Width="300">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Viewbox Width="11" Height="11" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z" Fill="{Binding TextMuted}"/>
                        </Viewbox>
                        <TextBox Grid.Column="1" Text="{Binding LogSearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="Transparent" BorderThickness="0" Foreground="{Binding TextMain}" 
                                 FontSize="11" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- ROW 2: DATAGRID CONTENT (DUAL VIEW: SUMMARY VS DETAILED LOGS)   -->
        <!-- ============================================================== -->
        <Grid Grid.Row="2" Margin="20,16">

            <!-- ========================================================== -->
            <!-- VIEW A: SYSTEM-WISE VIOLATION COUNTS SUMMARY TABLE         -->
            <!-- (Konsa system kitne baar threshold value ke upar gaya)     -->
            <!-- ========================================================== -->
            <DataGrid ItemsSource="{Binding FilteredStationBreachSummaries}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{Binding CardBorderBrush}"
                      Background="{Binding SurfaceBg}" RowBackground="Transparent" 
                      BorderBrush="{Binding CardBorderBrush}" BorderThickness="1"
                      Visibility="{Binding IsViewSummary, Converter={StaticResource BoolToVis}}">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{Binding SubHeaderBg, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Setter Property="Foreground" Value="{Binding TextMuted, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="10,10"/>
                        <Setter Property="BorderBrush" Value="{Binding CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Foreground" Value="{Binding TextMain, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontFamily" Value="Consolas"/>
                        <Setter Property="Padding" Value="4"/>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Workstation Node" Binding="{Binding StationId}" Width="150"/>
                    <DataGridTextColumn Header="Workstation Description" Binding="{Binding StationName}" Width="*"/>
                    <DataGridTextColumn Header="🔥 Times Threshold Exceeded" Binding="{Binding TotalBreachCount, StringFormat='{}{0} Times'}" Width="190">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Black"/>
                                <Setter Property="Foreground" Value="#dc2626"/>
                                <Setter Property="FontSize" Value="12"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="RAM Violations" Binding="{Binding RamBreachCount, StringFormat='{}{0} Events'}" Width="130"/>
                    <DataGridTextColumn Header="CPU Violations" Binding="{Binding CpuBreachCount, StringFormat='{}{0} Events'}" Width="130"/>
                    <DataGridTextColumn Header="Temp Junk Violations" Binding="{Binding TempBreachCount, StringFormat='{}{0} Events'}" Width="145"/>
                    <DataGridTextColumn Header="Offline / Timeout" Binding="{Binding HeartbeatBreachCount, StringFormat='{}{0} Events'}" Width="130"/>
                    <DataGridTextColumn Header="Last Breach Timestamp" Binding="{Binding LastBreachTime}" Width="190"/>
                    <DataGridTemplateColumn Header="Current Status" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding CurrentStateBadgeBg}" CornerRadius="2" Padding="8,3" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentState}" Foreground="{Binding CurrentStateBadgeFg}" FontWeight="Bold" FontSize="10"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- ========================================================== -->
            <!-- VIEW B: DETAILED THRESHOLD VIOLATION EVENT AUDIT LOG       -->
            <!-- (Chronological records of every threshold crossing)       -->
            <!-- ========================================================== -->
            <DataGrid ItemsSource="{Binding FilteredThresholdBreachLogs}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{Binding CardBorderBrush}"
                      Background="{Binding SurfaceBg}" RowBackground="Transparent" 
                      BorderBrush="{Binding CardBorderBrush}" BorderThickness="1"
                      Visibility="{Binding IsViewEvents, Converter={StaticResource BoolToVis}}">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{Binding SubHeaderBg, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Setter Property="Foreground" Value="{Binding TextMuted, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="10,10"/>
                        <Setter Property="BorderBrush" Value="{Binding CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Foreground" Value="{Binding TextMain, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontFamily" Value="Consolas"/>
                        <Setter Property="Padding" Value="4"/>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Event Ref" Binding="{Binding Id, StringFormat='#{0}'}" Width="85"/>
                    <DataGridTextColumn Header="Workstation Node" Binding="{Binding StationId}" Width="140"/>
                    <DataGridTextColumn Header="Workstation Name" Binding="{Binding StationName}" Width="230"/>
                    <DataGridTextColumn Header="Violated Parameter" Binding="{Binding ParameterName}" Width="190">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Recorded Value" Binding="{Binding RecordedValue}" Width="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#ef4444"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Threshold Limit" Binding="{Binding ThresholdLimit}" Width="130"/>
                    <DataGridTextColumn Header="Breach Time" Binding="{Binding BreachTime}" Width="190"/>
                    <DataGridTextColumn Header="Normalized Time" Binding="{Binding RecoveryTime}" Width="190"/>
                    <DataGridTextColumn Header="Duration Over Limit" Binding="{Binding DurationAboveThreshold}" Width="130"/>
                    <DataGridTemplateColumn Header="Violation Status" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="2" Padding="8,3" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#dcfce7"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="ACTIVE">
                                                    <Setter Property="Background" Value="#fee2e2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Status}" FontWeight="Bold" FontSize="10">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#15803d"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="ACTIVE">
                                                        <Setter Property="Foreground" Value="#b91c1c"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Zero Records Placeholder -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30"
                    Visibility="{Binding FilteredThresholdBreachLogs.Count, Converter={StaticResource BoolToVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FilteredThresholdBreachLogs.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center">
                    <Viewbox Width="24" Height="24" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <Path Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z" Fill="#16a34a"/>
                    </Viewbox>
                    <TextBlock Text="Zero Active Threshold Violations Recorded" FontSize="13" FontWeight="Bold" Foreground="{Binding TextMain}" HorizontalAlignment="Center"/>
                    <TextBlock Text="All workstation systems are currently operating within safe parameters." FontSize="11" Foreground="{Binding TextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============================================================== -->
        <!-- ROW 3: REGULATORY COMPLIANCE STATUS FOOTER (2D FLAT)           -->
        <!-- ============================================================== -->
        <Border Grid.Row="3" Background="{Binding HeaderBg}" BorderBrush="{Binding HeaderBorder}" BorderThickness="0,1,0,0" Padding="20,8">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle Width="6" Height="6" Fill="#10b981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Enterprise System Audit Trail &amp; Electronic Logging" FontWeight="Bold" FontSize="10" Foreground="#15803d"/>
                    <TextBlock Text="|" Foreground="{Binding HeaderSubFg}" Margin="8,0"/>
                    <TextBlock Text="Database Source: SQLite WAL (app_local.db)" FontSize="10" Foreground="{Binding HeaderSubFg}" FontFamily="Consolas"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Close Window" Width="100" Height="26" Background="{Binding HeaderBtnBg}" Foreground="{Binding HeaderBtnFg}" BorderBrush="{Binding HeaderBtnBorder}" BorderThickness="1" Cursor="Hand" Click="OnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
