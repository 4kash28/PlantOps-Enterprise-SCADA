<Window x:Class="DotNetApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DotNetApp.ViewModels"
        Title="PlantOps™ Enterprise SCADA v2.4 LTS — RAC Industrial Assembly Monitor"
        Height="900" Width="1440"
        MinHeight="720" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{Binding CanvasBg}"
        Foreground="{Binding TextMain}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- 2D Industrial Flat Button Style -->
        <Style x:Key="HeaderBtn" TargetType="Button">
            <Setter Property="Background" Value="{Binding HeaderBtnBg, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="Foreground" Value="{Binding HeaderBtnFg, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="BorderBrush" Value="{Binding HeaderBtnBorder, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Minimalist Ghost Button (Clean, Borderless) -->
        <Style x:Key="HeaderGhostBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{Binding TextMain, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{Binding SubHeaderBg, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Minimalist Icon Button (Clean, Borderless) -->
        <Style x:Key="HeaderIconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{Binding HeaderBtnFg, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{Binding SubHeaderBg, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Minimalist Status Capsule / Pill -->
        <Style x:Key="HeaderStatusPill" TargetType="Button">
            <Setter Property="Background" Value="{Binding SubHeaderBg, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="Foreground" Value="{Binding TextMain, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="BorderBrush" Value="{Binding SubHeaderBorder, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 2D KPI Card Border Style -->
        <Style x:Key="KpiCard" TargetType="Border">
            <Setter Property="Background" Value="{Binding SurfaceBg, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="BorderBrush" Value="{Binding CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <!-- Header Interactive Link Button -->
        <Style x:Key="HeaderLinkBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Top Dark Navbar -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Secondary Operations Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Scrollable Dashboard Content -->
            <RowDefinition Height="*"/>
            <!-- 3: Bottom Fixed Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- ROW 0: ENTERPRISE TOP NAVIGATION BAR (2D FLAT INDUSTRIAL)        -->
        <!-- ============================================================== -->
        <Border Grid.Row="0" Background="{Binding HeaderBg}" BorderBrush="{Binding HeaderBorder}" BorderThickness="0,0,0,1" Padding="16,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Corporate Brand & Hierarchy (2D Flat Clean UI) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource HeaderGhostBtn}" Click="OnAboutBtn_Click" ToolTip="Click for System Diagnostics &amp; Standards Compliance (21 CFR Part 11)" Padding="4,2,8,2" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="6" Margin="0,0,10,0" ClipToBounds="True">
                                <Image Source="/plantops_monitor.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="PLANTOPS" FontWeight="Black" FontSize="15" Foreground="{Binding HeaderFg}" FontFamily="Segoe UI"/>
                                    <TextBlock Text="SCADA" FontWeight="Bold" FontSize="15" Foreground="#0284c7" FontFamily="Segoe UI" Margin="5,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <StackPanel VerticalAlignment="Center">
                        <!-- Editable Plant & Production Line Button -->
                        <Button Style="{StaticResource HeaderLinkBtn}" Click="OnEditPlantProfile_Click" ToolTip="Click to Configure Factory Unit, Division &amp; Production Line" Margin="0,3,0,0" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PlantHierarchyText}" FontSize="11" Foreground="{Binding HeaderSubFg}" FontFamily="Segoe UI"/>
                                <Viewbox Width="10" Height="10" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <Path Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z" Fill="#0284c7"/>
                                </Viewbox>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Clean Minimalist Action Toolbar -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Unified Network & Node Status Capsule -->
                    <Button Style="{StaticResource HeaderStatusPill}" Click="OnNetworkBtn_Click" Margin="0,0,12,0"
                            ToolTip="SCADA Network &amp; Connected Workstations (Click for Network Wizard)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="#10b981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding HostIpAddress}" FontSize="10.5" FontWeight="Bold" FontFamily="Consolas" Foreground="{Binding TextMain}"/>
                            <TextBlock Text=" • " FontSize="10.5" Foreground="{Binding TextMuted}" Margin="3,0"/>
                            <TextBlock Text="{Binding CompactFleetStatusText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding TextMuted}"/>
                        </StackPanel>
                    </Button>

                    <!-- Clean Borderless Live Clock -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="{Binding LiveDateTooltip}">
                        <Viewbox Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center">
                            <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z" Fill="{Binding HeaderSubFg}"/>
                        </Viewbox>
                        <TextBlock Text="{Binding LiveClockText}" FontSize="11" FontFamily="Consolas" Foreground="{Binding HeaderSubFg}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Audit Log Ghost Button -->
                    <Button Style="{StaticResource HeaderGhostBtn}" Click="OnAuditLogHeaderBtn_Click" Margin="0,0,6,0"
                            ToolTip="System Parameter &amp; Threshold Breach Audit Log (Right-click to Clear)">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open Audit Log Window" Click="OnAuditLogHeaderBtn_Click"/>
                                <Separator/>
                                <MenuItem Header="📊 Export Excel Report (.xls)" Command="{Binding ExportExcelCommand}"/>
                                <MenuItem Header="📄 Export PDF Report (.pdf)" Command="{Binding ExportPdfCommand}"/>
                                <Separator/>
                                <MenuItem Header="🗑 Clear All Audit Logs (Reset to 0)" Command="{Binding ClearAuditLogsCommand}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center">
                                <Path Data="M19,3H14.82C14.4,1.84 13.3,1 12,1C10.7,1 9.6,1.84 9.18,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M12,3A1,1 0 0,1 13,4A1,1 0 0,1 12,5A1,1 0 0,1 11,4A1,1 0 0,1 12,3M7,7H17V9H7V7M7,11H17V13H7V11M7,15H14V17H7V15Z" Fill="#dc2626"/>
                            </Viewbox>
                            <TextBlock Text="Audit Log" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                            <Border Background="#dc2626" CornerRadius="8" Padding="5,1" Margin="5,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AuditLogCount}" FontSize="9" FontWeight="Bold" Foreground="White" FontFamily="Consolas"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <!-- Action Center Ghost Button -->
                    <Button Style="{StaticResource HeaderGhostBtn}" Click="OnTroubleshootingBtn_Click" Margin="0,0,8,0"
                            ToolTip="Workstation Priority &amp; Action Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center">
                                <Path Data="M12,2L1,21H23L12,2M12,6L19.53,19H4.47L12,6M11,10V14H13V10H11M11,16V18H13V16H11Z" Fill="#f59e0b"/>
                            </Viewbox>
                            <TextBlock Text="Action Center" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                            <Border Background="{Binding ActionRequiredBadgeBg}" CornerRadius="8" Padding="5,1" Margin="5,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ActionRequiredCount}" FontSize="9" FontWeight="Bold" Foreground="White" FontFamily="Consolas"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <!-- Subtle Soft Divider -->
                    <Rectangle Width="1" Height="16" Fill="{Binding HeaderBtnBorder}" Margin="0,0,8,0" VerticalAlignment="Center" Opacity="0.5"/>

                    <!-- Theme Toggle Icon Button -->
                    <Button Style="{StaticResource HeaderIconBtn}" Command="{Binding ToggleThemeCommand}" Margin="0,0,3,0" ToolTip="{Binding ThemeTooltip}">
                        <Viewbox Width="13" Height="13" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Path Data="M12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,2L14.39,5.42C13.65,5.15 12.84,5 12,5C11.16,5 10.35,5.15 9.61,5.42L12,2M3.34,7L7.5,6.65C6.9,7.16 6.36,7.78 5.94,8.5C5.5,9.24 5.25,10 5.11,10.79L3.34,7M3.36,17L5.12,13.23C5.26,14 5.53,14.78 5.95,15.5C6.37,16.24 6.91,16.86 7.5,17.37L3.36,17M20.65,7L18.88,10.79C18.74,10 18.47,9.23 18.05,8.5C17.63,7.78 17.1,7.15 16.5,16.64L20.65,7M20.64,17L16.5,17.36C17.09,16.85 17.62,16.22 18.04,15.5C18.46,14.77 18.73,14 18.87,13.21L20.64,17M12,22L9.59,18.56C10.33,18.83 11.14,19 12,19C12.82,19 13.63,18.83 14.37,18.56L12,22Z" Fill="{Binding HeaderBtnFg}"/>
                        </Viewbox>
                    </Button>

                    <!-- Siren Chime Icon Button -->
                    <Button Style="{StaticResource HeaderIconBtn}" Command="{Binding ToggleAudioCommand}" Margin="0,0,3,0" ToolTip="{Binding AudioTooltip}">
                        <Viewbox Width="13" Height="13" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Path Data="M12,2A2,2 0 0,0 10,4A2,2 0 0,0 10,4.29C7.12,5.14 5,7.82 5,11V17L3,19V20H21V19L19,17V11C19,7.82 16.88,5.14 14,4.29A2,2 0 0,0 14,4A2,2 0 0,0 12,2M10,21A2,2 0 0,0 12,23A2,2 0 0,0 14,21" Fill="{Binding AudioIconBrush}"/>
                        </Viewbox>
                    </Button>

                    <!-- Settings Button -->
                    <Button Style="{StaticResource HeaderIconBtn}" Click="OnSettingsBtn_Click" Margin="0,0,3,0" ToolTip="SCADA System Parameters &amp; Thresholds">
                        <Viewbox Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" Fill="{Binding HeaderBtnFg}"/>
                        </Viewbox>
                    </Button>

                    <!-- About / System Diagnostics Button -->
                    <Button Style="{StaticResource HeaderIconBtn}" Click="OnAboutBtn_Click" ToolTip="System Diagnostics &amp; Compliance Information (21 CFR Part 11)">
                        <Viewbox Width="13" Height="13" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Path Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z" Fill="{Binding HeaderBtnFg}"/>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- ROW 1: SECONDARY OPERATIONS TOOLBAR & TAB STRIP (2D FLAT)       -->
        <!-- ============================================================== -->
        <Border Grid.Row="1" Background="{Binding SubHeaderBg}" BorderBrush="{Binding SubHeaderBorder}" BorderThickness="0,0,0,1" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Active View Badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2563eb" CornerRadius="2" Padding="12,5">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Rectangle Width="6" Height="6" Fill="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="LINE 01 OVERVIEW" FontWeight="Black" FontSize="10" Foreground="White" FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: Stream Active Indicator -->
                <Border Grid.Column="2" Background="{Binding SurfaceBg}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="10,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Rectangle Width="6" Height="6" Fill="#10b981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="SCADA Core Stream Active" FontSize="10" FontWeight="SemiBold" Foreground="{Binding TextMuted}" FontFamily="Consolas"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- ROW 2: SCROLLABLE MAIN DASHBOARD CONTENT                       -->
        <!-- ============================================================== -->
        <ScrollViewer Grid.Row="2" x:Name="MainScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,14">
            <StackPanel MaxWidth="1780" HorizontalAlignment="Stretch">

                <!-- 5 ISA-101 KEY PERFORMANCE INDICATORS (KPIS) -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- KPI 1: Availability OEE -->
                    <Border Grid.Column="0" Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="LINE AVAILABILITY" FontSize="10" FontWeight="Bold" Foreground="{Binding TextMuted}"/>
                                <Border HorizontalAlignment="Right" Background="#dcfce7" CornerRadius="2" Padding="4,1">
                                    <TextBlock Text="OEE METRIC" FontSize="8" FontWeight="Bold" Foreground="#15803d"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding LineAvailabilityPct, StringFormat='{}{0:F1}%'}" FontSize="24" FontWeight="Black" Foreground="#16a34a" FontFamily="Consolas" Margin="0,6,0,0"/>
                            <TextBlock Text="Target: 98.5% | ISO 22400" FontSize="9" Foreground="{Binding TextMuted}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI 2: Total Workstations -->
                    <Border Grid.Column="1" Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="WORKSTATIONS" FontSize="10" FontWeight="Bold" Foreground="{Binding TextMuted}"/>
                                <Border HorizontalAlignment="Right" Background="#dbeafe" CornerRadius="2" Padding="4,1">
                                    <TextBlock Text="NODES" FontSize="8" FontWeight="Bold" Foreground="#1d4ed8"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding TotalStations}" FontSize="24" FontWeight="Black" Foreground="#2563eb" FontFamily="Consolas" Margin="0,6,0,0"/>
                            <TextBlock Text="Active Line Positions" FontSize="9" Foreground="{Binding TextMuted}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI 3: Nodes Online -->
                    <Border Grid.Column="2" Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="NODES ONLINE" FontSize="10" FontWeight="Bold" Foreground="{Binding TextMuted}"/>
                                <Border HorizontalAlignment="Right" Background="#dcfce7" CornerRadius="2" Padding="4,1">
                                    <TextBlock Text="HEALTHY" FontSize="8" FontWeight="Bold" Foreground="#15803d"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding OnlineStations}" FontSize="24" FontWeight="Black" Foreground="#10b981" FontFamily="Consolas" Margin="0,6,0,0"/>
                            <TextBlock Text="Live Telemetry Streams" FontSize="9" Foreground="{Binding TextMuted}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI 4: Active Stoppages -->
                    <Border Grid.Column="3" Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="ACTIVE STOPPAGES" FontSize="10" FontWeight="Bold" Foreground="{Binding TextMuted}"/>
                                <Border HorizontalAlignment="Right" Background="#fee2e2" CornerRadius="2" Padding="4,1">
                                    <TextBlock Text="CRITICAL" FontSize="8" FontWeight="Bold" Foreground="#b91c1c"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding CriticalStations}" FontSize="24" FontWeight="Black" Foreground="#ef4444" FontFamily="Consolas" Margin="0,6,0,0"/>
                            <TextBlock Text="Zero Line Interruption Target" FontSize="9" Foreground="{Binding TextMuted}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI 5: Offline / Standby -->
                    <Border Grid.Column="4" Style="{StaticResource KpiCard}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="OFFLINE / STANDBY" FontSize="10" FontWeight="Bold" Foreground="{Binding TextMuted}"/>
                                <Border HorizontalAlignment="Right" Background="#f1f5f9" CornerRadius="2" Padding="4,1">
                                    <TextBlock Text="> 10 SEC" FontSize="8" FontWeight="Bold" Foreground="#475569"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding OfflineStations}" FontSize="24" FontWeight="Black" Foreground="#64748b" FontFamily="Consolas" Margin="0,6,0,0"/>
                            <TextBlock Text="Awaiting Station Startup" FontSize="9" Foreground="{Binding TextMuted}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- SECTION: WORKSTATIONS GRID -->
                <Border Margin="0,0,0,16">
                    <StackPanel>
                        <!-- Section Header -->
                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Rectangle Width="10" Height="10" Fill="#2563eb" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="ASSEMBLY LINE WORKSTATIONS (LIVE INDUSTRIAL FACEPLATES)" FontWeight="Bold" FontSize="12" FontFamily="Consolas" Foreground="{Binding TextMain}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Ellipse Width="7" Height="7" Fill="#16a34a" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Nominal (&lt;70%)" FontSize="10" Foreground="{Binding TextMuted}" Margin="0,0,12,0"/>
                                <Ellipse Width="7" Height="7" Fill="#d97706" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Warning (&gt;85%)" FontSize="10" Foreground="{Binding TextMuted}" Margin="0,0,12,0"/>
                                <Ellipse Width="7" Height="7" Fill="#dc2626" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Critical Stoppage" FontSize="10" Foreground="{Binding TextMuted}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Empty State if no stations -->
                        <Border Background="{Binding SurfaceBg}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="40,24" Margin="0,0,0,10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Stations.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center">
                                <Viewbox Width="36" Height="36" HorizontalAlignment="Center" Margin="0,0,0,12">
                                    <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,6A6,6 0 0,0 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12A6,6 0 0,0 12,6M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8M12,10A2,2 0 0,0 10,12A2,2 0 0,0 12,14A2,2 0 0,0 14,12A2,2 0 0,0 12,10Z" Fill="{Binding TextMuted}"/>
                                </Viewbox>
                                <TextBlock Text="AWAITING REAL-TIME INDUSTRIAL LINE WORKSTATIONS..." FontWeight="Bold" FontSize="13" Foreground="{Binding TextMain}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Launch LineNodeAgent.exe on RAC line workstation PCs to stream live telemetry to central server (port 5050)." FontSize="11" Foreground="{Binding TextMuted}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Faceplate Cards Grid -->
                        <ItemsControl ItemsSource="{Binding Stations}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="450" Margin="0,0,16,16" Background="{Binding DataContext.SurfaceBg, RelativeSource={RelativeSource AncestorType=Window}}"
                                            BorderBrush="{Binding StatusBorderBrush}" BorderThickness="3,1,1,1" CornerRadius="3" Padding="16">
                                        <StackPanel>
                                            <!-- Card Header Row 1: Station Identity & Status Badge -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Left: LED Indicator + Station ID & Friendly Name -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Rectangle Width="9" Height="9" Fill="{Binding StatusLedBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding StationId}" FontWeight="Black" FontSize="14" FontFamily="Consolas" Foreground="{Binding DataContext.TextMain, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding StationName}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding DataContext.TextMuted, RelativeSource={RelativeSource AncestorType=Window}}" Margin="16,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <!-- Right: Status Alert Badge & Delete Button -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Background="{Binding StatusBadgeBg}" CornerRadius="3" Padding="8,3" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding StatusText}" FontSize="9" FontWeight="Black" FontFamily="Consolas" Foreground="{Binding StatusBadgeFg}"/>
                                                    </Border>
                                                    <Button Command="{Binding DeleteCommand}" Background="Transparent" BorderThickness="0" ToolTip="Deregister / Remove Station from SCADA" Cursor="Hand" Padding="3">
                                                        <Viewbox Width="12" Height="12">
                                                            <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z" Fill="{Binding DataContext.TextMuted, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        </Viewbox>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Card Header Row 2: Metadata Tags (Host, Permissions, Network) - Clean Non-Overlapping WrapPanel -->
                                            <WrapPanel Margin="0,0,0,10">
                                                <!-- Hostname Badge -->
                                                <Border Background="#1e293b" CornerRadius="2" Padding="6,2" Margin="0,0,6,4">
                                                    <TextBlock Text="{Binding Hostname, StringFormat='HOST: {0}'}" FontSize="9" FontWeight="Bold" Foreground="#38bdf8" FontFamily="Consolas"/>
                                                </Border>

                                                <!-- Permission Governance Badge -->
                                                <Border Background="{Binding PermBadgeBg}" CornerRadius="2" Padding="6,2" Margin="0,0,6,4">
                                                    <TextBlock Text="{Binding PermBadgeText}" FontSize="9" FontWeight="Bold" Foreground="{Binding PermBadgeFg}" FontFamily="Consolas"/>
                                                </Border>

                                                <!-- Network IP & Roundtrip Pill (Image 2 - Real-time Network Drop & Failure Indicator) -->
                                                <Border Background="{Binding NetworkPillBg}" BorderBrush="{Binding NetworkPillBorder}" BorderThickness="1" CornerRadius="3" Padding="7,3" Margin="0,0,0,4"
                                                        Visibility="{Binding ShowNetwork, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding NetworkPillConnText}" FontWeight="Bold" FontSize="9" Foreground="{Binding NetworkPillConnFg}" Margin="0,0,5,0"/>
                                                        <TextBlock Text="{Binding IpAddress}" FontFamily="Consolas" FontWeight="Bold" FontSize="9" Foreground="{Binding NetworkPillIpFg}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding NetworkPillLatencyText}" FontSize="9" FontFamily="Consolas" FontWeight="Bold" Foreground="{Binding NetworkPillLatencyFg}"/>
                                                    </StackPanel>
                                                </Border>
                                            </WrapPanel>

                                            <!-- Divider line -->
                                            <Rectangle Height="1" Fill="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,10"/>

                                            <!-- Core Resource Bars (CPU, RAM, Disk) -->
                                            <!-- Metric 1: CPU Workload (Dynamic Visibility) -->
                                            <StackPanel Visibility="{Binding ShowCpu, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6">
                                                <Grid Margin="0,0,0,3">
                                                    <TextBlock Text="CPU Workload" FontSize="10" FontWeight="SemiBold" Foreground="{Binding DataContext.TextMuted, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    <TextBlock Text="{Binding CpuDisplayText}" HorizontalAlignment="Right" FontSize="10" FontWeight="Bold" FontFamily="Consolas"/>
                                                </Grid>
                                                <ProgressBar Value="{Binding CpuPercent, Mode=OneWay}" Height="5" Maximum="100" Foreground="{Binding CpuBarBrush}"/>
                                            </StackPanel>

                                            <!-- Metric 2: RAM Commit (Dynamic Visibility) -->
                                            <StackPanel Visibility="{Binding ShowRam, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6">
                                                <Grid Margin="0,0,0,3">
                                                    <TextBlock Text="RAM Physical Commit" FontSize="10" FontWeight="SemiBold" Foreground="{Binding DataContext.TextMuted, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    <TextBlock Text="{Binding RamDisplayText}" HorizontalAlignment="Right" FontSize="10" FontWeight="Bold" FontFamily="Consolas"/>
                                                </Grid>
                                                <ProgressBar Value="{Binding RamPercent, Mode=OneWay}" Height="5" Maximum="100" Foreground="{Binding RamBarBrush}"/>
                                            </StackPanel>

                                            <!-- Metric 3: Main Disk (Dynamic Visibility) -->
                                            <StackPanel Visibility="{Binding ShowDisk, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
                                                <Grid Margin="0,0,0,3">
                                                    <TextBlock Text="NVMe/SSD (C:\)" FontSize="10" FontWeight="SemiBold" Foreground="{Binding DataContext.TextMuted, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    <TextBlock Text="{Binding DiskDisplayText}" HorizontalAlignment="Right" FontSize="10" FontWeight="Bold" FontFamily="Consolas"/>
                                                </Grid>
                                                <ProgressBar Value="{Binding DiskPercent, Mode=OneWay}" Height="5" Maximum="100" Foreground="#64748b"/>
                                            </StackPanel>

                                            <!-- Divider line -->
                                            <Rectangle Height="1" Fill="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,10"/>

                                            <!-- Secondary Diagnostics: Clean 2-Column Grid (MinHeight for Solid Card Stability) -->
                                            <Grid Margin="0,0,0,10" MinHeight="75">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="14"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Left Column: Hardware & Maintenance Metrics -->
                                                <StackPanel Grid.Column="0">
                                                    <!-- CPU Thermal Temperature -->
                                                    <Grid Margin="0,0,0,6" Visibility="{Binding ShowTemperature, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="CPU Temp:" FontSize="10" Foreground="{Binding DataContext.TextMuted, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        <TextBlock Text="{Binding TemperatureText}" HorizontalAlignment="Right" FontSize="10" FontWeight="Bold" FontFamily="Consolas" Foreground="#f97316"/>
                                                    </Grid>

                                                    <!-- Critical Processes -->
                                                    <Grid Margin="0,0,0,6" Visibility="{Binding ShowCriticalProcesses, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="Processes:" FontSize="10" Foreground="{Binding DataContext.TextMuted, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        <TextBlock Text="{Binding CriticalProcessesText}" HorizontalAlignment="Right" FontSize="10" FontWeight="Bold" FontFamily="Consolas" Foreground="#10b981"/>
                                                    </Grid>

                                                    <!-- Windows Services -->
                                                    <Grid Margin="0,0,0,6" Visibility="{Binding ShowWindowsServices, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="Services:" FontSize="10" Foreground="{Binding DataContext.TextMuted, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        <TextBlock Text="{Binding WindowsServicesText}" HorizontalAlignment="Right" FontSize="10" FontWeight="Bold" FontFamily="Consolas" Foreground="#a855f7"/>
                                                    </Grid>

                                                    <!-- Temp & Prefetch Files Storage -->
                                                    <Grid Margin="0,0,0,6" Visibility="{Binding ShowTempJunk, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="Temp/Prefetch:" FontSize="10" Foreground="{Binding DataContext.TextMuted, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        <TextBlock Text="{Binding TempJunkText}" HorizontalAlignment="Right" FontSize="10" FontWeight="Bold" FontFamily="Consolas" Foreground="{Binding TempJunkBrush}"/>
                                                    </Grid>
                                                </StackPanel>

                                                <!-- Right Column: System & Peripheral Metrics -->
                                                <StackPanel Grid.Column="2">
                                                    <!-- Host Uptime -->
                                                    <Grid Margin="0,0,0,6" Visibility="{Binding ShowUptime, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="Host Uptime:" FontSize="10" Foreground="{Binding DataContext.TextMuted, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        <TextBlock Text="{Binding UptimeText}" HorizontalAlignment="Right" FontSize="10" FontWeight="Bold" FontFamily="Consolas" Foreground="{Binding UptimeBrush}"/>
                                                    </Grid>

                                                    <!-- Active Windows Operator -->
                                                    <Grid Margin="0,0,0,6" Visibility="{Binding ShowActiveUser, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="Operator:" FontSize="10" Foreground="{Binding DataContext.TextMuted, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        <TextBlock Text="{Binding ActiveUserText}" HorizontalAlignment="Right" FontSize="10" FontWeight="Bold" FontFamily="Consolas" Foreground="#38bdf8" TextTrimming="CharacterEllipsis" MaxWidth="125"/>
                                                    </Grid>

                                                    <!-- USB Peripherals -->
                                                    <Grid Margin="0,0,0,6" Visibility="{Binding ShowUsbPeripherals, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="USB Devices:" FontSize="10" Foreground="{Binding DataContext.TextMuted, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        <TextBlock Text="{Binding UsbPeripheralsText}" HorizontalAlignment="Right" FontSize="10" FontWeight="Bold" FontFamily="Consolas" Foreground="#06b6d4"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================================================== -->
        <!-- ROW 3: FIXED BOTTOM WINDOWS DESKTOP SCADA STATUS BAR (2D FLAT)   -->
        <!-- ============================================================== -->
        <Border Grid.Row="3" Background="{Binding HeaderBg}" BorderBrush="{Binding HeaderBorder}" BorderThickness="0,1,0,0" Padding="16,6">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle Width="6" Height="6" Fill="#10b981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="PlantOps™ SCADA Core Engine Active" FontWeight="Bold" FontSize="10" Foreground="#15803d"/>
                    <TextBlock Text="|" Foreground="{Binding HeaderSubFg}" Margin="8,0"/>
                    <TextBlock Text="RAC Line 01 Production Network" FontSize="10" Foreground="{Binding HeaderSubFg}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="DATABASE: SQLite WAL 3.45 (app_local.db)" FontSize="10" FontFamily="Consolas" Foreground="{Binding HeaderSubFg}"/>
                    <TextBlock Text="|" Foreground="{Binding HeaderSubFg}" Margin="8,0"/>
                    <TextBlock Text="CYCLE: 3.0s" FontSize="10" FontFamily="Consolas" Foreground="{Binding HeaderSubFg}"/>
                    <TextBlock Text="|" Foreground="{Binding HeaderSubFg}" Margin="8,0"/>
                    <TextBlock Text="ISO 11064 / ISA-101 COMPLIANT" FontSize="10" FontWeight="Bold" Foreground="{Binding HeaderFg}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
