<Window x:Class="DotNetApp.Views.InstallationWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PlantOps™ Enterprise SCADA — Setup &amp; License Wizard"
        Height="620" Width="820"
        MinHeight="580" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#f8fafc"
        Foreground="#0f172a"
        FontFamily="Segoe UI, Segoe UI Variable, Arial"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- Microsoft Fluent Accent Primary Button -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background" Value="#0067c0"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="22,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#005fb8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1075cc"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#e2e8f0"/>
                    <Setter Property="BorderBrush" Value="#cbd5e1"/>
                    <Setter Property="Foreground" Value="#94a3b8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Microsoft Fluent Secondary Button -->
        <Style x:Key="SecondaryNavBtn" TargetType="Button" BasedOn="{StaticResource NavBtn}">
            <Setter Property="Background" Value="#f1f5f9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#cbd5e1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#e2e8f0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Clean Fluent Card Style -->
        <Style x:Key="FluentCard" TargetType="Border">
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#e2e8f0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,16"/>
        </Style>

        <!-- Clean Form TextBox Style (Zero Clipping, Crisp Typography) -->
        <Style x:Key="WizardTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="Foreground" Value="#0f172a"/>
            <Setter Property="BorderBrush" Value="#cbd5e1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#0078d4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Horizontal Stepper Strip -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Spacious Full-Width Content -->
            <RowDefinition Height="*"/>
            <!-- 3: Bottom Navigation Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- ROW 0: CLEAN MICROSOFT .NET ENTERPRISE HEADER                  -->
        <!-- ============================================================== -->
        <Border Grid.Row="0" Background="#ffffff" BorderBrush="#e2e8f0" BorderThickness="0,0,0,1" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Margin="0,0,14,0" ClipToBounds="True">
                    <Image Source="/plantops_monitor.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="PlantOps™ Enterprise SCADA" FontSize="16" FontWeight="Bold" Foreground="#0f172a"/>
                        <Border Background="#eff6ff" BorderBrush="#bfdbfe" BorderThickness="1" CornerRadius="3" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text=".NET 8 LTS" FontSize="9.5" FontWeight="Bold" Foreground="#1d4ed8" FontFamily="Consolas"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Central Assembly Line SCADA Server • Setup &amp; License Wizard" FontSize="11" Foreground="#64748b" Margin="0,2,0,0"/>
                </StackPanel>

                <Border Grid.Column="2" Background="#ecfdf5" BorderBrush="#a7f3d0" BorderThickness="1" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock Text="21 CFR PART 11 CERTIFIED" FontSize="9" FontWeight="Bold" Foreground="#047857" FontFamily="Consolas"/>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- ROW 1: HORIZONTAL MODERN STEPPER (CLEAN PROGRESS TABS)         -->
        <!-- ============================================================== -->
        <Border Grid.Row="1" Background="#f1f5f9" BorderBrush="#e2e8f0" BorderThickness="0,0,0,1" Padding="20,8">
            <UniformGrid Rows="1" Columns="6">
                <!-- Step 0 -->
                <Border x:Name="StepItem0" Background="#dbeafe" BorderBrush="#bfdbfe" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="3,0">
                    <TextBlock x:Name="StepTxt0" Text="1. Welcome" FontSize="10.5" FontWeight="Bold" Foreground="#1d4ed8" HorizontalAlignment="Center"/>
                </Border>
                <!-- Step 1 -->
                <Border x:Name="StepItem1" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="3,0">
                    <TextBlock x:Name="StepTxt1" Text="2. License" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748b" HorizontalAlignment="Center"/>
                </Border>
                <!-- Step 2 -->
                <Border x:Name="StepItem2" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="3,0">
                    <TextBlock x:Name="StepTxt2" Text="3. Facility Profile" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748b" HorizontalAlignment="Center"/>
                </Border>
                <!-- Step 3 -->
                <Border x:Name="StepItem3" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="3,0">
                    <TextBlock x:Name="StepTxt3" Text="4. Options" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748b" HorizontalAlignment="Center"/>
                </Border>
                <!-- Step 4 -->
                <Border x:Name="StepItem4" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="3,0">
                    <TextBlock x:Name="StepTxt4" Text="5. Installation" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748b" HorizontalAlignment="Center"/>
                </Border>
                <!-- Step 5 -->
                <Border x:Name="StepItem5" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="3,0">
                    <TextBlock x:Name="StepTxt5" Text="6. Complete" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748b" HorizontalAlignment="Center"/>
                </Border>
            </UniformGrid>
        </Border>

        <!-- ============================================================== -->
        <!-- ROW 2: SPACIOUS FULL-WIDTH CONTENT AREA                        -->
        <!-- ============================================================== -->
        <Grid Grid.Row="2" Margin="28,20">

            <!-- STEP 0: WELCOME & CAPABILITIES -->
            <Grid x:Name="StepPanel0" Visibility="Visible">
                <StackPanel>
                    <TextBlock Text="Welcome to PlantOps™ Enterprise SCADA" FontSize="17" FontWeight="Bold" Foreground="#0f172a" Margin="0,0,0,4"/>
                    <TextBlock Text="This setup wizard will configure, license, and optimize PlantOps™ SCADA on this machine." FontSize="11.5" Foreground="#64748b" Margin="0,0,0,18"/>

                    <!-- Spacious 2x2 Feature Highlights (Clean Microsoft Fluent Grid) -->
                    <UniformGrid Columns="2" Rows="2" Margin="0,0,0,18">
                        <!-- Feature 1 -->
                        <Border Style="{StaticResource FluentCard}" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Text="⚡ Microsoft .NET 8 WPF Engine" FontWeight="Bold" FontSize="12" Foreground="#0067c0" Margin="0,0,0,4"/>
                                <TextBlock Text="High-performance, hardware-accelerated desktop application designed for 24/7 industrial factory lines." FontSize="10.5" Foreground="#64748b" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Feature 2 -->
                        <Border Style="{StaticResource FluentCard}" Margin="8,0,0,8">
                            <StackPanel>
                                <TextBlock Text="🌐 Telemetry Server (Port 5050)" FontWeight="Bold" FontSize="12" Foreground="#0067c0" Margin="0,0,0,4"/>
                                <TextBlock Text="Embedded HTTP server for ingesting real-time hardware telemetry from 10–11+ line workstation PCs." FontSize="10.5" Foreground="#64748b" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Feature 3 -->
                        <Border Style="{StaticResource FluentCard}" Margin="0,8,8,0">
                            <StackPanel>
                                <TextBlock Text="🗄 Local SQLite WAL Database" FontWeight="Bold" FontSize="12" Foreground="#0067c0" Margin="0,0,0,4"/>
                                <TextBlock Text="Zero external server setup required. All downtime logs, settings, and audits persist locally in WAL mode." FontSize="10.5" Foreground="#64748b" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Feature 4 -->
                        <Border Style="{StaticResource FluentCard}" Margin="8,8,0,0">
                            <StackPanel>
                                <TextBlock Text="🛡 21 CFR Part 11 &amp; Air-Gapped" FontWeight="Bold" FontSize="12" Foreground="#0067c0" Margin="0,0,0,4"/>
                                <TextBlock Text="Certified electronic records and audit trail. Operates 100% locally with zero cloud dependencies." FontSize="10.5" Foreground="#64748b" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <TextBlock Text="Click 'Next' to review and accept the official Software License Agreement (EULA)." FontSize="11" Foreground="#64748b"/>
                </StackPanel>
            </Grid>

            <!-- STEP 1: LICENSE AGREEMENT (EULA) -->
            <Grid x:Name="StepPanel1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Software License Agreement (EULA)" FontSize="16" FontWeight="Bold" Foreground="#0f172a"/>
                    <TextBlock Text="Please read and accept the terms of the Enterprise Software License to continue:" FontSize="11" Foreground="#64748b" Margin="0,2,0,0"/>
                </StackPanel>

                <Border Grid.Row="1" Background="#ffffff" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,0,14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="TxtLicenseTerms" IsReadOnly="True" Background="#f8fafc" Foreground="#1e293b" 
                                 BorderThickness="0" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap"
                                 Padding="10" VerticalScrollBarVisibility="Disabled"/>
                    </ScrollViewer>
                </Border>

                <StackPanel Grid.Row="2">
                    <RadioButton x:Name="RbAcceptLicense" Content="I accept the terms in the License Agreement (Authorized Factory Deployment)" 
                                 Foreground="#0f172a" FontWeight="Bold" FontSize="11.5" Margin="0,0,0,6"
                                 Checked="OnLicenseAgreementChanged" Unchecked="OnLicenseAgreementChanged"/>
                    <RadioButton x:Name="RbDeclineLicense" Content="I do not accept the terms of the License Agreement" 
                                 IsChecked="True" Foreground="#64748b" FontSize="11"
                                 Checked="OnLicenseAgreementChanged" Unchecked="OnLicenseAgreementChanged"/>
                </StackPanel>
            </Grid>

            <!-- STEP 2: PLANT & FACILITY PROFILE (NO LICENSE KEY) -->
            <Grid x:Name="StepPanel2" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Plant &amp; Facility Profile" FontSize="16" FontWeight="Bold" Foreground="#0f172a" Margin="0,0,0,4"/>
                    <TextBlock Text="Configure plant identity and production line metadata for this central SCADA server:" FontSize="11" Foreground="#64748b" Margin="0,0,0,16"/>

                    <Border Style="{StaticResource FluentCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <!-- Facility & Line Row -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Plant / Facility Name" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                                    <TextBox x:Name="TxtWizardPlantName" Text="Plant 01 (Chennai Works)" Style="{StaticResource WizardTextBox}" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Production Line / Unit" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                                    <TextBox x:Name="TxtWizardLineName" Text="RAC Line 01" Style="{StaticResource WizardTextBox}" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>

                            <!-- Division -->
                            <StackPanel Margin="0,0,0,4">
                                <TextBlock Text="Department / Division" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                                <TextBox x:Name="TxtWizardDivisionName" Text="Assembly Division" Style="{StaticResource WizardTextBox}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="#f0fdf4" BorderBrush="#bbf7d0" BorderThickness="1" CornerRadius="6" Padding="14,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#16a34a" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Enterprise Ready: All shop-floor telemetry and audit logs will be tagged with this facility profile." FontSize="11" Foreground="#166534" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- STEP 3: SETUP OPTIONS -->
            <Grid x:Name="StepPanel3" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Installation &amp; Integration Options" FontSize="16" FontWeight="Bold" Foreground="#0f172a" Margin="0,0,0,4"/>
                    <TextBlock Text="Select configuration options to apply to this system:" FontSize="11" Foreground="#64748b" Margin="0,0,0,16"/>

                    <Border Style="{StaticResource FluentCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <CheckBox x:Name="ChkRegisterUninstall" Content="Register in Windows Programs &amp; Features (Control Panel Uninstaller)" 
                                      IsChecked="True" Foreground="#0f172a" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,14"/>
                            <CheckBox x:Name="ChkFirewall" Content="Configure Windows Defender Firewall (Allow Port 5050 TCP Inbound for Line Agents)" 
                                      IsChecked="True" Foreground="#0f172a" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,14"/>
                            <CheckBox x:Name="ChkDesktopShortcut" Content="Create Desktop Shortcut ('PlantOps Enterprise SCADA')" 
                                      IsChecked="True" Foreground="#0f172a" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,14"/>
                            <CheckBox x:Name="ChkStartMenuShortcut" Content="Create Windows Start Menu Program Shortcut" 
                                      IsChecked="True" Foreground="#0f172a" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,14"/>
                            <CheckBox x:Name="ChkSqliteInit" Content="Initialize Local SQLite Audit Trail Database ('app_local.db' in WAL mode)" 
                                      IsChecked="True" IsEnabled="False" Foreground="#64748b" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Click 'Install' to apply these configurations and complete setup." FontSize="11" Foreground="#64748b"/>
                </StackPanel>
            </Grid>

            <!-- STEP 4: INSTALLATION PROGRESS -->
            <Grid x:Name="StepPanel4" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" Margin="0,40,0,0">
                    <TextBlock Text="Configuring PlantOps™ Enterprise SCADA..." FontSize="17" FontWeight="Bold" Foreground="#0f172a" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtInstallStatus" Text="Initializing installation procedures..." FontSize="11.5" FontWeight="Bold" Foreground="#0067c0" Margin="0,0,0,14"/>

                    <ProgressBar x:Name="PbInstallProgress" Height="10" Minimum="0" Maximum="100" Value="10"
                                 Background="#e2e8f0" Foreground="#10b981" BorderThickness="0" Margin="0,0,0,14"/>

                    <Border Background="#ffffff" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="6" Padding="12,10">
                        <TextBlock x:Name="TxtInstallDetail" Text="Registering Enterprise License &amp; Writing Configurations..." 
                                   FontSize="10.5" FontFamily="Consolas" Foreground="#64748b"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- STEP 5: COMPLETED -->
            <Grid x:Name="StepPanel5" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                        <Border Width="26" Height="26" Background="#ecfdf5" CornerRadius="13" Margin="0,0,10,0">
                            <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z" Fill="#059669"/>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="Installation &amp; License Setup Complete!" FontSize="17" FontWeight="Bold" Foreground="#059669" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="PlantOps™ Enterprise SCADA has been successfully installed, licensed, and configured on this PC." 
                               FontSize="11" Foreground="#64748b" Margin="0,0,0,16"/>

                    <Border Style="{StaticResource FluentCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="INSTALLATION SUMMARY" FontSize="9.5" FontWeight="Bold" Foreground="#0067c0" FontFamily="Consolas" Margin="0,0,0,8"/>
                            <TextBlock x:Name="TxtSummaryDetails" Text="• License: ACTIVE&#x0a;• Compliance: 21 CFR Part 11 Certified&#x0a;• Database: app_local.db (SQLite WAL Mode Active)&#x0a;• Telemetry Ingestion: Port 5050 TCP Open&#x0a;• Registered in Windows Programs &amp; Features" 
                                       FontSize="11" FontFamily="Consolas" Foreground="#1e293b" LineHeight="20"/>
                        </StackPanel>
                    </Border>

                    <CheckBox x:Name="ChkLaunchNow" Content="Launch PlantOps™ Enterprise SCADA now" 
                              IsChecked="True" Foreground="#0f172a" FontWeight="Bold" FontSize="11.5"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ============================================================== -->
        <!-- ROW 3: BOTTOM NAVIGATION BUTTON BAR                            -->
        <!-- ============================================================== -->
        <Border Grid.Row="3" Background="#ffffff" BorderBrush="#e2e8f0" BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource SecondaryNavBtn}" HorizontalAlignment="Left" Click="OnCancel_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnBack" Content="&lt; Back" Style="{StaticResource SecondaryNavBtn}" Margin="0,0,8,0" Click="OnBack_Click"/>
                    <Button x:Name="BtnNext" Content="Next &gt;" Style="{StaticResource NavBtn}" Click="OnNext_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
