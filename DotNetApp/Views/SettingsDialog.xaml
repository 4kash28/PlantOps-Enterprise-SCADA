<Window x:Class="DotNetApp.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SCADA System Parameters &amp; Thresholds"
        Height="820" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#f8fafc"
        Foreground="#0f172a"
        FontFamily="Segoe UI">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Form Card -->
            <RowDefinition Height="*"/>
            <!-- 2: Action Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header (2D Flat) -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="34" Height="34" Background="#dbeafe" BorderBrush="#bfdbfe" BorderThickness="1" CornerRadius="2" Margin="0,0,12,0">
                    <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" Fill="#0284c7"/>
                    </Viewbox>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SCADA THRESHOLD CONFIGURATION" FontWeight="Black" FontSize="14" Foreground="#0f172a" FontFamily="Consolas"/>
                    <TextBlock Text="ISA-101 High Performance HMI Alarm Triggers &amp; Watchdogs" FontSize="11" Foreground="#64748b" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Form Fields Card (2D Flat) -->
        <Border Grid.Row="1" Background="#ffffff" CornerRadius="2" Padding="18,16" BorderBrush="#e2e8f0" BorderThickness="1">
            <StackPanel>
                <!-- CPU Warning -->
                <TextBlock Text="CPU WARNING THRESHOLD (%):" FontSize="9" FontWeight="Bold" Foreground="#475569" FontFamily="Consolas"/>
                <TextBox x:Name="TxtCpuWarning" Height="30" Margin="0,3,0,10" Background="#f8fafc" Foreground="#0f172a" 
                         BorderBrush="#cbd5e1" BorderThickness="1" Padding="8,4" FontSize="12" FontFamily="Consolas" VerticalContentAlignment="Center"/>

                <!-- CPU Critical -->
                <TextBlock Text="CPU CRITICAL THRESHOLD (%):" FontSize="9" FontWeight="Bold" Foreground="#475569" FontFamily="Consolas"/>
                <TextBox x:Name="TxtCpuCritical" Height="30" Margin="0,3,0,10" Background="#f8fafc" Foreground="#b91c1c" FontWeight="Bold"
                         BorderBrush="#cbd5e1" BorderThickness="1" Padding="8,4" FontSize="12" FontFamily="Consolas" VerticalContentAlignment="Center"/>

                <!-- RAM Warning -->
                <TextBlock Text="RAM PHYSICAL COMMIT WARNING (%):" FontSize="9" FontWeight="Bold" Foreground="#475569" FontFamily="Consolas"/>
                <TextBox x:Name="TxtRamWarning" Height="30" Margin="0,3,0,10" Background="#f8fafc" Foreground="#0f172a" 
                         BorderBrush="#cbd5e1" BorderThickness="1" Padding="8,4" FontSize="12" FontFamily="Consolas" VerticalContentAlignment="Center"/>

                <!-- RAM Critical -->
                <TextBlock Text="RAM CRITICAL THRESHOLD (%):" FontSize="9" FontWeight="Bold" Foreground="#475569" FontFamily="Consolas"/>
                <TextBox x:Name="TxtRamCritical" Height="30" Margin="0,3,0,10" Background="#f8fafc" Foreground="#b91c1c" FontWeight="Bold"
                         BorderBrush="#cbd5e1" BorderThickness="1" Padding="8,4" FontSize="12" FontFamily="Consolas" VerticalContentAlignment="Center"/>

                <!-- Heartbeat Timeout (Full Visibility, No Cutoff, 2D Flat) -->
                <TextBlock Text="HEARTBEAT OFFLINE TIMEOUT (SECONDS):" FontSize="9" FontWeight="Bold" Foreground="#475569" FontFamily="Consolas"/>
                <TextBox x:Name="TxtHeartbeat" Height="30" Margin="0,3,0,10" Background="#f8fafc" Foreground="#0f172a" FontWeight="Bold"
                         BorderBrush="#cbd5e1" BorderThickness="1" Padding="8,4" FontSize="12" FontFamily="Consolas" VerticalContentAlignment="Center"/>

                <!-- Temp & Prefetch Files Threshold -->
                <TextBlock Text="TEMP &amp; PREFETCH FILES THRESHOLD (MAX COUNT):" FontSize="9" FontWeight="Bold" Foreground="#475569" FontFamily="Consolas"/>
                <TextBox x:Name="TxtTempFilesThreshold" Height="30" Margin="0,3,0,10" Background="#f8fafc" Foreground="#b91c1c" FontWeight="Bold"
                         BorderBrush="#cbd5e1" BorderThickness="1" Padding="8,4" FontSize="12" FontFamily="Consolas" VerticalContentAlignment="Center"
                         ToolTip="Triggers violation in audit log when workstation junk files exceed this count"/>

                <!-- Host Uptime Warning Threshold -->
                <TextBlock Text="HOST CONTINUOUS UPTIME THRESHOLD (MAX HOURS):" FontSize="9" FontWeight="Bold" Foreground="#475569" FontFamily="Consolas"/>
                <TextBox x:Name="TxtUptimeThreshold" Height="30" Margin="0,3,0,10" Background="#f8fafc" Foreground="#b91c1c" FontWeight="Bold"
                         BorderBrush="#cbd5e1" BorderThickness="1" Padding="8,4" FontSize="12" FontFamily="Consolas" VerticalContentAlignment="Center"
                         ToolTip="Triggers violation in audit log when workstation continuous uptime exceeds this limit (e.g. 48 for 2 days, 72 for 3 days, 168 for 7 days)"/>

                <!-- Emergency Alarm Audio Siren Configuration & Test -->
                <TextBlock Text="INDUSTRIAL EMERGENCY ALARM SIREN:" FontSize="9" FontWeight="Bold" Foreground="#475569" FontFamily="Consolas" Margin="0,4,0,3"/>
                <Border Background="#f1f5f9" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="2" Padding="10,8" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <CheckBox x:Name="ChkAlarmSiren" Content="Enable Alarm Audio Siren" FontWeight="Bold" FontSize="11" Foreground="#0f172a" VerticalContentAlignment="Center"/>
                            <TextBlock Text="High-intensity dual-tone siren on violations &amp; network disconnects" FontSize="9" Foreground="#64748b" Margin="20,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Click="TestSiren_Click" Height="28" Padding="12,2" 
                                Background="#dc2626" Foreground="White" FontWeight="Bold" FontSize="10.5" BorderThickness="0" Cursor="Hand" ToolTip="Test Emergency Alarm Siren Output">
                            <TextBlock Text="🔊 Test Siren"/>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Action Buttons (2D Flat) -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Button HorizontalAlignment="Left" Width="145" Height="34" 
                    Background="#eff6ff" Foreground="#1d4ed8" BorderBrush="#bfdbfe" BorderThickness="1" 
                    FontWeight="SemiBold" FontSize="11" Cursor="Hand" Click="EditPlantProfile_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center">
                        <Path Data="M2,22V10L10,14V8L18,12V2H22V22H2M6,14H8V16H6V14M6,18H8V20H6V18M10,18H12V20H10V18M14,18H16V20H14V18M18,14H20V16H18V14M18,18H20V20H18V18M18,6H20V8H18V6M18,10H20V12H18V10Z" Fill="#1d4ed8"/>
                    </Viewbox>
                    <TextBlock Text="Edit Plant Profile"/>
                </StackPanel>
            </Button>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="90" Height="34" Margin="0,0,10,0" 
                        Background="#f1f5f9" Foreground="#334155" BorderBrush="#cbd5e1" BorderThickness="1" 
                        FontWeight="SemiBold" Cursor="Hand" Click="Cancel_Click"/>
                <Button Width="140" Height="34" 
                        Background="#2563eb" Foreground="White" FontWeight="Bold" BorderThickness="0" 
                        Cursor="Hand" Click="Save_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Path Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z" Fill="White"/>
                        </Viewbox>
                        <TextBlock Text="Save Thresholds"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
