<Window x:Class="DotNetApp.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About PlantOps™ Enterprise SCADA"
        Height="540" Width="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{Binding CanvasBg}"
        Foreground="{Binding TextMain}"
        FontFamily="Segoe UI Variable, Segoe UI, -apple-system, Arial"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Microsoft Fluent Secondary Button -->
        <Style x:Key="AboutSecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{Binding HeaderBtnBg}"/>
            <Setter Property="Foreground" Value="{Binding HeaderBtnFg}"/>
            <Setter Property="BorderBrush" Value="{Binding HeaderBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Microsoft Fluent Primary Button -->
        <Style x:Key="AboutPrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#0067c0"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#005fb8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1075cc"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- 0: Header with Logo and Title -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Compliance Badges -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Diagnostics & Details Card -->
            <RowDefinition Height="*"/>
            <!-- 3: Action Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="48" Height="48" CornerRadius="8" Background="{Binding SurfaceBg}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" Margin="0,0,14,0">
                    <Image Source="/plantops_monitor.png" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="PlantOps™ Enterprise SCADA" FontWeight="Bold" FontSize="18" Foreground="{Binding HeaderFg}"/>
                        <Border Background="#eff6ff" BorderBrush="#bfdbfe" BorderThickness="1" CornerRadius="4" Padding="7,1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v2.4.0 LTS" FontSize="10" FontWeight="Bold" Foreground="#1d4ed8" FontFamily="Consolas"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="High-Performance Industrial Supervisory Control &amp; Telemetry Central" FontSize="11" Foreground="{Binding TextMuted}" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- COMPLIANCE BADGES -->
        <Border Grid.Row="1" Background="{Binding SurfaceBg}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="🛡️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="21 CFR Part 11" FontWeight="Bold" FontSize="11" Foreground="#0284c7"/>
                        <TextBlock Text="Tamper-Resistant Audit" FontSize="9.5" Foreground="{Binding TextMuted}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="📊" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ISA-101.01" FontWeight="Bold" FontSize="11" Foreground="#059669"/>
                        <TextBlock Text="High-Perf Situational HMI" FontSize="9.5" Foreground="{Binding TextMuted}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="🏢" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ISO 11064" FontWeight="Bold" FontSize="11" Foreground="#d97706"/>
                        <TextBlock Text="Ergonomic Control Centre" FontSize="9.5" Foreground="{Binding TextMuted}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DIAGNOSTICS & SYSTEM INFO -->
        <Border Grid.Row="2" Background="{Binding SurfaceBg}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18,16" Margin="0,0,0,16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Telemetry & Network -->
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="ENGINE &amp; TELEMETRY" FontWeight="Bold" FontSize="10.5" Foreground="{Binding TextMuted}" Margin="0,0,0,10"/>

                        <TextBlock Text="Telemetry Ingestion URL:" FontSize="10" Foreground="{Binding TextMuted}"/>
                        <TextBlock x:Name="TxtTelemetryUrl" Text="http://127.0.0.1:5050/api/telemetry" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Foreground="#0284c7" Margin="0,2,0,9"/>

                        <TextBlock Text="Database Architecture:" FontSize="10" Foreground="{Binding TextMuted}"/>
                        <TextBlock Text="SQLite 3.45 WAL (app_local.db)" FontFamily="Consolas" FontSize="11" Foreground="{Binding TextMain}" Margin="0,2,0,9"/>

                        <TextBlock Text="Monitored Fleet:" FontSize="10" Foreground="{Binding TextMuted}"/>
                        <TextBlock x:Name="TxtFleetSummary" Text="1 Workstation Online (6 Configured)" FontFamily="Consolas" FontSize="11" Foreground="#16a34a" FontWeight="Bold" Margin="0,2,0,9"/>

                        <TextBlock Text="Runtime Architecture:" FontSize="10" Foreground="{Binding TextMuted}"/>
                        <TextBlock x:Name="TxtRuntime" Text=".NET 8.0 Windows x64 (Single-File)" FontFamily="Consolas" FontSize="11" Foreground="{Binding TextMain}"/>
                    </StackPanel>

                    <!-- Right: License & Plant Profile -->
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="FACILITY &amp; LICENSE" FontWeight="Bold" FontSize="10.5" Foreground="{Binding TextMuted}" Margin="0,0,0,10"/>

                        <TextBlock Text="Plant Facility:" FontSize="10" Foreground="{Binding TextMuted}"/>
                        <TextBlock x:Name="TxtFacility" Text="Plant 01 (Chennai Works)" FontWeight="SemiBold" FontSize="11" Foreground="{Binding TextMain}" Margin="0,2,0,9"/>

                        <TextBlock Text="Assembly Division:" FontSize="10" Foreground="{Binding TextMuted}"/>
                        <TextBlock x:Name="TxtDivision" Text="Assembly Division — RAC Line 01" FontWeight="SemiBold" FontSize="11" Foreground="{Binding TextMain}" Margin="0,2,0,9"/>

                        <TextBlock Text="License Activation Key:" FontSize="10" Foreground="{Binding TextMuted}"/>
                        <TextBlock Text="0151-1956-6563 (Active Lifetime)" FontFamily="Consolas" FontSize="11" Foreground="#16a34a" FontWeight="Bold" Margin="0,2,0,9"/>

                        <TextBlock Text="Process Memory (Working Set):" FontSize="10" Foreground="{Binding TextMuted}"/>
                        <TextBlock x:Name="TxtMemory" Text="182 MB Commit" FontFamily="Consolas" FontSize="11" Foreground="{Binding TextMain}"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- FOOTER / BUTTONS -->
        <Grid Grid.Row="3">
            <TextBlock Text="© 2026 PlantOps Industrial Automation Solutions. All rights reserved." VerticalAlignment="Center" FontSize="10" Foreground="{Binding TextMuted}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="📋 Copy Diagnostics" Click="OnCopyDiagnostics_Click"
                        Style="{StaticResource AboutSecondaryBtn}" Margin="0,0,8,0" ToolTip="Copy System Diagnostics to Clipboard"/>
                <Button Content="Close" Click="OnClose_Click" IsDefault="True"
                        Style="{StaticResource AboutPrimaryBtn}" ToolTip="Close Diagnostics Window"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
