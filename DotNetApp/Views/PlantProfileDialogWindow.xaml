<Window x:Class="DotNetApp.Views.PlantProfileDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configure Plant Identity &amp; Production Line"
        Height="520" Width="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#f8fafc"
        Foreground="#0f172a"
        FontFamily="Segoe UI">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Form Body -->
            <RowDefinition Height="*"/>
            <!-- 2: Action Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header (2D Flat) -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="34" Height="34" Background="#dbeafe" BorderBrush="#bfdbfe" BorderThickness="1" CornerRadius="2" Margin="0,0,12,0">
                    <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M2,22V10L10,14V8L18,12V2H22V22H2M6,14H8V16H6V14M6,18H8V20H6V18M10,18H12V20H10V18M14,18H16V20H14V18M18,14H20V16H18V14M18,18H20V20H18V18M18,6H20V8H18V6M18,10H20V12H18V10Z" Fill="#0284c7"/>
                    </Viewbox>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="FACTORY &amp; PRODUCTION LINE CONFIGURATION" FontWeight="Black" FontSize="14" Foreground="#0f172a" FontFamily="Consolas"/>
                    <TextBlock Text="Configure the facility name, division, and production line identifier" FontSize="11" Foreground="#64748b" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Form Box (2D Flat) -->
        <Border Grid.Row="1" Background="#ffffff" CornerRadius="2" Padding="18,16" BorderBrush="#e2e8f0" BorderThickness="1">
            <StackPanel>
                <!-- Plant / Factory Name -->
                <TextBlock Text="1. PLANT / FACTORY NAME:" FontSize="9" FontWeight="Bold" Foreground="#475569" FontFamily="Consolas"/>
                <TextBox x:Name="TxtPlantName" Height="30" Margin="0,3,0,10" Background="#f8fafc" Foreground="#0f172a" 
                         BorderBrush="#cbd5e1" BorderThickness="1" Padding="8,4" FontSize="12" FontFamily="Consolas" 
                         VerticalContentAlignment="Center" TextChanged="OnInput_TextChanged"/>

                <!-- Department / Division -->
                <TextBlock Text="2. DEPARTMENT / DIVISION:" FontSize="9" FontWeight="Bold" Foreground="#475569" FontFamily="Consolas"/>
                <TextBox x:Name="TxtDivisionName" Height="30" Margin="0,3,0,10" Background="#f8fafc" Foreground="#0f172a" 
                         BorderBrush="#cbd5e1" BorderThickness="1" Padding="8,4" FontSize="12" FontFamily="Consolas" 
                         VerticalContentAlignment="Center" TextChanged="OnInput_TextChanged"/>

                <!-- Production Line -->
                <TextBlock Text="3. PRODUCTION LINE / UNIT:" FontSize="9" FontWeight="Bold" Foreground="#475569" FontFamily="Consolas"/>
                <TextBox x:Name="TxtLineName" Height="30" Margin="0,3,0,12" Background="#f8fafc" Foreground="#0f172a" 
                         BorderBrush="#cbd5e1" BorderThickness="1" Padding="8,4" FontSize="12" FontFamily="Consolas" 
                         VerticalContentAlignment="Center" TextChanged="OnInput_TextChanged"/>

                <!-- Live Preview Card (2D Flat) -->
                <Border Background="#eff6ff" CornerRadius="2" BorderBrush="#bfdbfe" BorderThickness="1" Padding="12,8">
                    <StackPanel>
                        <TextBlock Text="LIVE HEADER PREVIEW:" FontSize="9" FontWeight="Black" Foreground="#1d4ed8" FontFamily="Consolas"/>
                        <TextBlock x:Name="TxtPreview" Text="Plant 01 (Chennai Works) • Assembly Division • RAC Line 01" 
                                   FontSize="11" FontWeight="Bold" Foreground="#1e40af" Margin="0,3,0,0" FontFamily="Consolas"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Action Buttons (2D Flat) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Reset Default" Width="105" Height="34" Margin="0,0,10,0" 
                    Background="#f1f5f9" Foreground="#475569" BorderBrush="#cbd5e1" BorderThickness="1" 
                    FontWeight="SemiBold" Cursor="Hand" Click="ResetDefault_Click"/>
            <Button Content="Cancel" Width="85" Height="34" Margin="0,0,10,0" 
                    Background="#f1f5f9" Foreground="#334155" BorderBrush="#cbd5e1" BorderThickness="1" 
                    FontWeight="SemiBold" Cursor="Hand" Click="Cancel_Click"/>
            <Button Width="135" Height="34" 
                    Background="#2563eb" Foreground="White" FontWeight="Bold" BorderThickness="0" 
                    Cursor="Hand" Click="Save_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center">
                        <Path Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z" Fill="White"/>
                    </Viewbox>
                    <TextBlock Text="Save &amp; Apply"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
