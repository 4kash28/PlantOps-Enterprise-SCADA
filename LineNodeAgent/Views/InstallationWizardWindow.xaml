<Window x:Class="LineNodeAgent.Views.InstallationWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PlantOps™ Line Node Agent — Workstation Setup &amp; Provisioning Wizard"
        Height="620" Width="820"
        MinHeight="580" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#f8fafc"
        Foreground="#0f172a"
        FontFamily="Segoe UI, Segoe UI Variable, Arial"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- Microsoft Fluent Accent Primary Button -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background" Value="#0067c0"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="22,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#005fb8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1075cc"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#e2e8f0"/>
                    <Setter Property="BorderBrush" Value="#cbd5e1"/>
                    <Setter Property="Foreground" Value="#94a3b8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Microsoft Fluent Secondary Button -->
        <Style x:Key="SecondaryNavBtn" TargetType="Button" BasedOn="{StaticResource NavBtn}">
            <Setter Property="Background" Value="#f1f5f9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#cbd5e1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#e2e8f0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Clean Fluent Card Style -->
        <Style x:Key="FluentCard" TargetType="Border">
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#e2e8f0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,16"/>
        </Style>

        <!-- Clean Form TextBox Style (Zero Clipping, Crisp Typography) -->
        <Style x:Key="WizardTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="Foreground" Value="#0f172a"/>
            <Setter Property="BorderBrush" Value="#cbd5e1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#0078d4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Horizontal Stepper Strip -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Spacious Full-Width Content -->
            <RowDefinition Height="*"/>
            <!-- 3: Bottom Navigation Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- ROW 0: CLEAN MICROSOFT .NET ENTERPRISE HEADER                  -->
        <!-- ============================================================== -->
        <Border Grid.Row="0" Background="#ffffff" BorderBrush="#e2e8f0" BorderThickness="0,0,0,1" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Margin="0,0,14,0" ClipToBounds="True">
                    <Image Source="/linenode_agent.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="PlantOps™ Line Node Agent" FontSize="16" FontWeight="Bold" Foreground="#0f172a"/>
                        <Border Background="#eff6ff" BorderBrush="#bfdbfe" BorderThickness="1" CornerRadius="3" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text=".NET 8 LTS" FontSize="9.5" FontWeight="Bold" Foreground="#1d4ed8" FontFamily="Consolas"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Shop-Floor Assembly Workstation Telemetry • Setup &amp; Provisioning Wizard" FontSize="11" Foreground="#64748b" Margin="0,2,0,0"/>
                </StackPanel>

                <Border Grid.Column="2" Background="#ecfdf5" BorderBrush="#a7f3d0" BorderThickness="1" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock Text="21 CFR PART 11 CERTIFIED" FontSize="9" FontWeight="Bold" Foreground="#047857" FontFamily="Consolas"/>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- ROW 1: HORIZONTAL MODERN STEPPER (CLEAN PROGRESS TABS)         -->
        <!-- ============================================================== -->
        <Border Grid.Row="1" Background="#f1f5f9" BorderBrush="#e2e8f0" BorderThickness="0,0,0,1" Padding="20,8">
            <UniformGrid Rows="1" Columns="6">
                <!-- Step 0 -->
                <Border x:Name="StepItem0" Background="#dbeafe" BorderBrush="#bfdbfe" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="3,0">
                    <TextBlock x:Name="StepTxt0" Text="1. Welcome" FontSize="10.5" FontWeight="Bold" Foreground="#1d4ed8" HorizontalAlignment="Center"/>
                </Border>
                <!-- Step 1 -->
                <Border x:Name="StepItem1" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="3,0">
                    <TextBlock x:Name="StepTxt1" Text="2. Agreement" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748b" HorizontalAlignment="Center"/>
                </Border>
                <!-- Step 2 -->
                <Border x:Name="StepItem2" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="3,0">
                    <TextBlock x:Name="StepTxt2" Text="3. Station ID" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748b" HorizontalAlignment="Center"/>
                </Border>
                <!-- Step 3 -->
                <Border x:Name="StepItem3" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="3,0">
                    <TextBlock x:Name="StepTxt3" Text="4. SCADA Link" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748b" HorizontalAlignment="Center"/>
                </Border>
                <!-- Step 4 -->
                <Border x:Name="StepItem4" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="3,0">
                    <TextBlock x:Name="StepTxt4" Text="5. Integration" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748b" HorizontalAlignment="Center"/>
                </Border>
                <!-- Step 5 -->
                <Border x:Name="StepItem5" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="3,0">
                    <TextBlock x:Name="StepTxt5" Text="6. Complete" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748b" HorizontalAlignment="Center"/>
                </Border>
            </UniformGrid>
        </Border>

        <!-- ============================================================== -->
        <!-- ROW 2: SPACIOUS FULL-WIDTH CONTENT AREA                        -->
        <!-- ============================================================== -->
        <Grid Grid.Row="2" Margin="28,20">

            <!-- STEP 0: WELCOME & CAPABILITIES -->
            <Grid x:Name="StepPanel0" Visibility="Visible">
                <StackPanel>
                    <TextBlock Text="Welcome to PlantOps™ Line Node Agent Setup" FontSize="17" FontWeight="Bold" Foreground="#0f172a" Margin="0,0,0,4"/>
                    <TextBlock Text="This setup wizard will configure and provision this workstation PC for real-time telemetry streaming to SCADA Central." FontSize="11.5" Foreground="#64748b" Margin="0,0,0,18"/>

                    <!-- Spacious 2x2 Feature Highlights (Clean Microsoft Fluent Grid) -->
                    <UniformGrid Columns="2" Rows="2" Margin="0,0,0,18">
                        <!-- Feature 1 -->
                        <Border Style="{StaticResource FluentCard}" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Text="⚡ Microsoft .NET 8 Performance" FontWeight="Bold" FontSize="12" Foreground="#0067c0" Margin="0,0,0,4"/>
                                <TextBlock Text="High-performance client with less than 0.5% CPU overhead, ensuring zero lag for shop-floor operators." FontSize="10.5" Foreground="#64748b" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Feature 2 -->
                        <Border Style="{StaticResource FluentCard}" Margin="8,0,0,8">
                            <StackPanel>
                                <TextBlock Text="📡 WMI &amp; Hardware Telemetry" FontWeight="Bold" FontSize="12" Foreground="#0067c0" Margin="0,0,0,4"/>
                                <TextBlock Text="Autonomous monitoring of CPU, RAM, Disk, Temperature, Uptime, Network Latency, and USB peripherals." FontSize="10.5" Foreground="#64748b" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Feature 3 -->
                        <Border Style="{StaticResource FluentCard}" Margin="0,8,8,0">
                            <StackPanel>
                                <TextBlock Text="🔒 Background Service Execution" FontWeight="Bold" FontSize="12" Foreground="#0067c0" Margin="0,0,0,4"/>
                                <TextBlock Text="Runs 24/7 in Windows System Tray. Closing the window minimizes silently so telemetry streaming never stops." FontSize="10.5" Foreground="#64748b" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Feature 4 -->
                        <Border Style="{StaticResource FluentCard}" Margin="8,8,0,0">
                            <StackPanel>
                                <TextBlock Text="🛡 21 CFR Part 11 &amp; Air-Gapped" FontWeight="Bold" FontSize="12" Foreground="#0067c0" Margin="0,0,0,4"/>
                                <TextBlock Text="Local factory LAN communication only. Zero external cloud connectivity, strictly air-gapped and secure." FontSize="10.5" Foreground="#64748b" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <TextBlock Text="Click 'Next' to review and accept the official Deployment Agreement." FontSize="11" Foreground="#64748b"/>
                </StackPanel>
            </Grid>

            <!-- STEP 1: LICENSE AGREEMENT (EULA) -->
            <Grid x:Name="StepPanel1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Software License &amp; Deployment Terms" FontSize="16" FontWeight="Bold" Foreground="#0f172a"/>
                    <TextBlock Text="Please read and accept the PlantOps Line Node Agent deployment authorization to continue:" FontSize="11" Foreground="#64748b" Margin="0,2,0,0"/>
                </StackPanel>

                <Border Grid.Row="1" Background="#ffffff" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,0,14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="TxtLicenseTerms" IsReadOnly="True" Background="#f8fafc" Foreground="#1e293b" 
                                 BorderThickness="0" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap"
                                 Padding="10" VerticalScrollBarVisibility="Disabled"/>
                    </ScrollViewer>
                </Border>

                <StackPanel Grid.Row="2">
                    <RadioButton x:Name="RbAcceptLicense" Content="I accept the PlantOps industrial operational agreement and deployment authorization" 
                                 Foreground="#0f172a" FontWeight="Bold" FontSize="11.5" Margin="0,0,0,6"
                                 Checked="OnLicenseAgreementChanged" Unchecked="OnLicenseAgreementChanged"/>
                    <RadioButton x:Name="RbDeclineLicense" Content="I do not accept the terms of the deployment agreement" 
                                 IsChecked="True" Foreground="#64748b" FontSize="11"
                                 Checked="OnLicenseAgreementChanged" Unchecked="OnLicenseAgreementChanged"/>
                </StackPanel>
            </Grid>

            <!-- STEP 2: WORKSTATION & ASSEMBLY STATION IDENTITY -->
            <Grid x:Name="StepPanel2" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Workstation &amp; Assembly Station Identity" FontSize="16" FontWeight="Bold" Foreground="#0f172a" Margin="0,0,0,4"/>
                    <TextBlock Text="Define the workstation identifier and human-readable station title for the SCADA dashboard:" FontSize="11" Foreground="#64748b" Margin="0,0,0,16"/>

                    <Border Style="{StaticResource FluentCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <!-- Hostname & Station ID Row -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Workstation Hostname (Local Machine)" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                                    <TextBox x:Name="TxtMachineName" Style="{StaticResource WizardTextBox}" IsReadOnly="True" Background="#f8fafc" Foreground="#0284c7" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Line Station Identifier (Node ID)" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="CmbStationId" Height="38" Background="#ffffff" BorderBrush="#cbd5e1" BorderThickness="1" Padding="12,8" FontSize="12" FontFamily="Consolas" IsEditable="True">
                                        <ComboBoxItem Content="LINE1 1" IsSelected="True"/>
                                        <ComboBoxItem Content="START"/>
                                        <ComboBoxItem Content="RAC_LINE_01"/>
                                        <ComboBoxItem Content="VACUUM_PUMP"/>
                                        <ComboBoxItem Content="REFRIGERANT_CHARGE"/>
                                        <ComboBoxItem Content="LEAK_DETECTION"/>
                                        <ComboBoxItem Content="ELECTRICAL_SAFETY"/>
                                        <ComboBoxItem Content="RUN_TEST_BENCH"/>
                                        <ComboBoxItem Content="FINAL_QC_AUDIT"/>
                                        <ComboBoxItem Content="PACKAGING_OUT"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- Station Friendly Title -->
                            <StackPanel Margin="0,0,0,4">
                                <TextBlock Text="Station Friendly Title / Operation Subtitle" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                                <TextBox x:Name="TxtStationFriendlyName" Text="IDU" Style="{StaticResource WizardTextBox}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="#f0fdf4" BorderBrush="#bbf7d0" BorderThickness="1" CornerRadius="6" Padding="14,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#16a34a" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Tip: Every workstation running this agent appears as an active faceplate card on the central SCADA monitor." FontSize="11" Foreground="#166534" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- STEP 3: CENTRAL SCADA SERVER CONNECTIVITY -->
            <Grid x:Name="StepPanel3" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Central SCADA Host Connectivity" FontSize="16" FontWeight="Bold" Foreground="#0f172a" Margin="0,0,0,4"/>
                    <TextBlock Text="Specify the IP address and port of the central PlantOps SCADA Dashboard server:" FontSize="11" Foreground="#64748b" Margin="0,0,0,16"/>

                    <Border Style="{StaticResource FluentCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <!-- Server URL Row with Test Link Button -->
                            <TextBlock Text="Central SCADA Dashboard Endpoint (URL)" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtServerUrl" Grid.Column="0" Text="http://localhost:5050" Style="{StaticResource WizardTextBox}" Margin="0,0,10,0"/>
                                <Button Grid.Column="1" Content="📡 Test Link" Style="{StaticResource NavBtn}" Height="38" Click="OnTestLink_Click"/>
                            </Grid>

                            <!-- Polling Frequency -->
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Telemetry Transmission Interval (Seconds)" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                                <TextBox x:Name="TxtInterval" Text="1" Width="100" HorizontalAlignment="Left" Style="{StaticResource WizardTextBox}"/>
                            </StackPanel>

                            <!-- Feedback Status Box -->
                            <Border x:Name="LinkFeedbackBorder" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="NETWORK STATUS FEEDBACK" FontSize="9" FontWeight="Bold" Foreground="#0067c0" FontFamily="Consolas"/>
                                    <TextBlock x:Name="TxtLinkFeedback" Text="Ready to test connection to Central SCADA server. Click 'Test Link' above." FontSize="11" Foreground="#1e293b" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- STEP 4: WINDOWS INTEGRATION & SYSTEM OPTIONS -->
            <Grid x:Name="StepPanel4" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Windows Integration &amp; Background Execution" FontSize="16" FontWeight="Bold" Foreground="#0f172a" Margin="0,0,0,4"/>
                    <TextBlock Text="Configure background execution and Windows startup settings for this workstation:" FontSize="11" Foreground="#64748b" Margin="0,0,0,16"/>

                    <Border Style="{StaticResource FluentCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <CheckBox x:Name="ChkAutoStart" Content="Run Line Node Agent automatically when Windows starts (HKCU\Run Startup)" 
                                      IsChecked="True" Foreground="#0f172a" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,14"/>
                            <CheckBox x:Name="ChkMinimizeToTray" Content="Minimize to Windows System Tray on close (Run 24/7 in background)" 
                                      IsChecked="True" Foreground="#0f172a" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,14"/>
                            <CheckBox x:Name="ChkDesktopShortcut" Content="Create Desktop Shortcut ('PlantOps Line Node Agent')" 
                                      IsChecked="True" Foreground="#0f172a" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,14"/>
                            <CheckBox x:Name="ChkRegisterUninstall" Content="Register in Windows Programs and Features (Control Panel Uninstaller)" 
                                      IsChecked="True" Foreground="#0f172a" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,14"/>
                            <CheckBox x:Name="ChkSqliteInit" Content="Initialize Local SQLite Telemetry Database ('agent_config.db')" 
                                      IsChecked="True" IsEnabled="False" Foreground="#64748b" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Click 'Install' to apply these configurations and provision the workstation." FontSize="11" Foreground="#64748b"/>
                </StackPanel>
            </Grid>

            <!-- STEP 5: INSTALLATION PROGRESS -->
            <Grid x:Name="StepPanel5" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" Margin="0,40,0,0">
                    <TextBlock Text="Provisioning PlantOps™ Line Node Agent..." FontSize="17" FontWeight="Bold" Foreground="#0f172a" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtInstallStatus" Text="Initializing workstation provisioning..." FontSize="11.5" FontWeight="Bold" Foreground="#0067c0" Margin="0,0,0,14"/>

                    <ProgressBar x:Name="PbInstallProgress" Height="10" Minimum="0" Maximum="100" Value="10"
                                 Background="#e2e8f0" Foreground="#10b981" BorderThickness="0" Margin="0,0,0,14"/>

                    <Border Background="#ffffff" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="6" Padding="12,10">
                        <TextBlock x:Name="TxtInstallDetail" Text="Writing agent configurations and persistence settings..." 
                                   FontSize="10.5" FontFamily="Consolas" Foreground="#64748b"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- STEP 6: COMPLETED -->
            <Grid x:Name="StepPanel6" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                        <Border Width="26" Height="26" Background="#ecfdf5" CornerRadius="13" Margin="0,0,10,0">
                            <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z" Fill="#059669"/>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="Workstation Provisioning Complete!" FontSize="17" FontWeight="Bold" Foreground="#059669" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="PlantOps™ Line Node Agent has been successfully configured and is ready to stream telemetry." 
                               FontSize="11" Foreground="#64748b" Margin="0,0,0,16"/>

                    <Border Style="{StaticResource FluentCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="DEPLOYMENT SUMMARY" FontSize="9.5" FontWeight="Bold" Foreground="#0067c0" FontFamily="Consolas" Margin="0,0,0,8"/>
                            <TextBlock x:Name="TxtSummaryDetails" Text="• Station: LINE1 1 (IDU)&#x0a;• SCADA Server: http://localhost:5050&#x0a;• Frequency: 1 second&#x0a;• Windows Startup: Registered&#x0a;• Background Service: Active in System Tray" 
                                       FontSize="11" FontFamily="Consolas" Foreground="#1e293b" LineHeight="20"/>
                        </StackPanel>
                    </Border>

                    <CheckBox x:Name="ChkLaunchNow" Content="Launch PlantOps™ Line Node Agent now and start streaming" 
                              IsChecked="True" Foreground="#0f172a" FontWeight="Bold" FontSize="11.5"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ============================================================== -->
        <!-- ROW 3: BOTTOM NAVIGATION BUTTON BAR                            -->
        <!-- ============================================================== -->
        <Border Grid.Row="3" Background="#ffffff" BorderBrush="#e2e8f0" BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource SecondaryNavBtn}" HorizontalAlignment="Left" Click="OnCancel_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnBack" Content="&lt; Back" Style="{StaticResource SecondaryNavBtn}" Margin="0,0,8,0" Click="OnBack_Click"/>
                    <Button x:Name="BtnNext" Content="Next &gt;" Style="{StaticResource NavBtn}" Click="OnNext_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
